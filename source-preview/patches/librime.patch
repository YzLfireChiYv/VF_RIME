+//
+#ifndef RIME_INTERACTION_CANDIDATE_H_
+#define RIME_INTERACTION_CANDIDATE_H_
+
+#include <rime/candidate.h>
+#include <rime_interaction_api.h>
+
+namespace rime {
+namespace interaction {
+
+// Explicit whole-composition result. The stamp is copied when interaction
+// back-links are stripped, so a rod payload cannot lose its scope guard.
+class AtomicCandidate : public ShadowCandidate {
+ public:
+  AtomicCandidate(an<Candidate> candidate, uint64_t instance_id,
+                  uint64_t input_revision, string input, string mode);
+  an<AtomicCandidate> WithPayload(an<Candidate> payload) const;
+  uint64_t instance_id() const { return instance_id_; }
+  uint64_t input_revision() const { return input_revision_; }
+  const string& input() const { return input_; }
+  const string& mode() const { return mode_; }
+
+ private:
+  uint64_t instance_id_;
+  uint64_t input_revision_;
+  string input_;
+  string mode_;
+};
+
+bool HasAtomicCandidate(const an<Candidate>& candidate);
+// Ambiguous (multi-item) uniquified results intentionally have no atomic scope.
+an<AtomicCandidate> AsAtomicCandidate(const an<Candidate>& candidate);
+
+enum class ItemKind {
+  kNone = kRimeInteractionKindNone,
+  kSource = kRimeInteractionKindSource,
+  kAssociated = kRimeInteractionKindAssociated,
+  kNotice = kRimeInteractionKindNotice,
+  kOutput = kRimeInteractionKindOutput,
+};
+
+inline const char* KindName(ItemKind kind) {
+  switch (kind) {
+    case ItemKind::kSource:
+      return "source";
+    case ItemKind::kAssociated:
+      return "associated";
+    case ItemKind::kNotice:
+      return "notice";
+    case ItemKind::kOutput:
+      return "output";
+    default:
+      return "";
+  }
+}
+
+inline ItemKind KindFromName(const string& name) {
+  if (name == "source")
+    return ItemKind::kSource;
+  if (name == "associated")
+    return ItemKind::kAssociated;
+  if (name == "notice")
+    return ItemKind::kNotice;
+  if (name == "output")
+    return ItemKind::kOutput;
+  return ItemKind::kNone;
+}
+
+inline const char* ActionName(ItemKind kind) {
+  return kind == ItemKind::kNotice ? "notice" : "commit";
+}
+
+// Rod child. Holds a real Candidate for output items; notice has no payload.
+// These are not inserted into the main candidate page.
+// payload never stores InteractionCandidate: that wrapper may hold source_
+// back to this object and would form a shared_ptr cycle. Store the inner
+// genuine candidate so text() and learning identity stay reachable.
+struct Attachment {
+  ItemKind kind = ItemKind::kNotice;
+  string label;
+  string comment;
+  string hint;  // Display-only prefix, independent of label and real payload.
+  string style_key;  // Display-only profile key; empty inherits the parent style.
+  an<Candidate> payload;
+  size_t start = 0;
+  size_t end = 0;
+};
+
+// Decorates a real candidate (Phrase, SimpleCandidate, ...).
+// Inherits ShadowCandidate so GetGenuineCandidate() reaches the wrapped item.
+class InteractionCandidate : public ShadowCandidate {
+ public:
+  InteractionCandidate(const an<Candidate>& item,
+                       ItemKind kind,
+                       const string& label = string(),
+                       const string& comment = string());
+
+  ItemKind kind() const { return kind_; }
+  void set_kind(ItemKind kind) { kind_ = kind; }
+
+  const string& label() const { return label_; }
+  bool label_explicit() const { return label_explicit_; }
+  void set_label(const string& label) {
+    label_ = label;
+    label_explicit_ = true;
+  }
+
+  const string& style_key() const { return style_key_; }
+  void set_style_key(const string& style_key) { style_key_ = style_key; }
+
+  string comment() const override;
+  void set_display_comment(const string& comment);
+
+  const an<InteractionCandidate>& source() const { return source_; }
+  // Strong ref so a live associated item cannot see a dangling source.
+  // Rejects self-pointer and source chains that would cycle.
+  bool set_source(an<InteractionCandidate> source);
+
+  const vector<Attachment>& attachments() const { return attachments_; }
+  bool Attach(Attachment attachment);
+
+ private:
+  ItemKind kind_ = ItemKind::kSource;
+  string label_;
+  bool label_explicit_ = false;
+  string style_key_;
+  string display_comment_;
+  bool has_display_comment_ = false;
+  an<InteractionCandidate> source_;
+  vector<Attachment> attachments_;
+};
+
+an<InteractionCandidate> AsInteraction(const an<Candidate>& cand);
+// Holds converted appearance while wrapping a genuine learning candidate.
+// GetGenuineCandidate() still reaches genuine_ because this is a Shadow.
+class HeldPayload : public ShadowCandidate {
+ public:
+  HeldPayload(const an<Candidate>& genuine, const Candidate& appearance);
+  string preedit() const override;
+
+ private:
+  string preedit_;
+};
+
+// Strip Interaction source/attachment back-links through Shadow/Interaction
+// layers. Keeps outermost text, preedit, comment, type, start/end, quality.
+// Returns nullptr if a Uniquified set cannot be rebuilt without a cycle.
+an<Candidate> AcyclicPayload(const an<Candidate>& cand);
+
+}  // namespace interaction
+}  // namespace rime
+
+#endif  // RIME_INTERACTION_CANDIDATE_H_
