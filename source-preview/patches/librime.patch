+namespace {
+
+char* DupStr(const string& value) {
+  if (value.empty())
+    return nullptr;
+  char* out = new char[value.size() + 1];
+  std::memcpy(out, value.c_str(), value.size() + 1);
+  return out;
+}
+
+struct SnapshotHolder {
+  RimeInteractionSnapshot view{};
+  vector<an<Candidate>> payloads;
+  vector<string> style_keys;
+  an<Menu> menu;
+  SessionId session_id = 0;
+  uint32_t generation = 0;
+  bool valid = true;
+};
+
+struct SpatialNode {
+  RimeInteractionRect rect{};
+  uint32_t anchor = 0;
+  bool rod = false;
+};
+
+struct SpatialLayout {
+  uint32_t generation = 0;
+  uint64_t frame_token = 0;
+  uint64_t revision = 0;
+  vector<SpatialNode> nodes;
+};
+
+struct SessionState {
+  uint32_t generation = 0;
+  string fingerprint;
+  SpatialLayout layout;
+  vector<uint64_t> retired_frames;
+};
+
+std::mutex g_mutex;
+map<SessionId, SessionState> g_sessions;
+std::unordered_set<SnapshotHolder*> g_holders;
+std::unordered_set<RimeInteractionPreedit*> g_preedits;
+
+void DestroyPreedit(RimeInteractionPreedit* value) {
+  delete[] value->text;
+  for (int i = 0; i < value->span_count; ++i)
+    delete[] value->spans[i].style_key;
+  delete[] value->spans;
+  delete value;
+}
+
+void ClearView(RimeInteractionSnapshot* view) {
+  if (!view)
+    return;
+  delete[] view->schema_id;
+  delete[] view->input;
+  if (view->items) {
+    for (int i = 0; i < view->item_count; ++i) {
+      delete[] view->items[i].label;
+      delete[] view->items[i].comment;
+      delete[] view->items[i].text;
+      delete[] view->items[i].action;
+      delete[] view->items[i].hint;
+    }
+    delete[] view->items;
+  }
+  view->schema_id = nullptr;
+  view->input = nullptr;
+  view->items = nullptr;
+  view->item_count = 0;
+}
+
+void AppendTagged(string* fp, char tag, const string& value) {
+  fp->push_back(tag);
+  fp->append(std::to_string(value.size()));
+  fp->push_back(':');
+  fp->append(value);
+  fp->push_back(';');
+}
+
+void AppendTagged(string* fp, char tag, uint64_t value) {
+  fp->push_back(tag);
+  fp->append(std::to_string(value));
+  fp->push_back(';');
+}
+
+string CandidateText(const an<Candidate>& cand) {
+  return cand ? cand->text() : string();
+}
+
+void FingerprintCandidate(string* fp, const an<Candidate>& cand) {
+  if (!cand) {
+    AppendTagged(fp, 'N', uint64_t{0});
+    return;
+  }
+  // Instance token is internal to generation. It is not a public item id.
+  AppendTagged(fp, 'P', static_cast<uint64_t>(reinterpret_cast<uintptr_t>(cand.get())));
+  AppendTagged(fp, 'Y', cand->type());
+  AppendTagged(fp, 'T', cand->text());
+  AppendTagged(fp, 'c', cand->comment());
+  AppendTagged(fp, 'S', static_cast<uint64_t>(cand->start()));
+  AppendTagged(fp, 'E', static_cast<uint64_t>(cand->end()));
+  if (auto item = AsInteraction(cand)) {
+    AppendTagged(fp, 'K', string(KindName(item->kind())));
+    AppendTagged(fp, 'L', item->label());
+    AppendTagged(fp, 'l', static_cast<uint64_t>(item->label_explicit()));
+    AppendTagged(fp, 'C', item->comment());
+    AppendTagged(fp, 'Z', item->style_key());
+    if (item->source()) {
+      AppendTagged(fp, 'R', static_cast<uint64_t>(
+                                reinterpret_cast<uintptr_t>(item->source().get())));
+      AppendTagged(fp, 'U', item->source()->type());
+      AppendTagged(fp, 'V', item->source()->text());
+    } else {
+      AppendTagged(fp, 'R', uint64_t{0});
+    }
+    AppendTagged(fp, 'A', static_cast<uint64_t>(item->attachments().size()));
+    for (const auto& row : item->attachments()) {
+      AppendTagged(fp, 'k', string(KindName(row.kind)));
+      AppendTagged(fp, 'l', row.label);
+      AppendTagged(fp, 'c', row.comment);
+      AppendTagged(fp, 'h', row.hint);
+      AppendTagged(fp, 'z', row.style_key);
+      AppendTagged(fp, 't', CandidateText(row.payload));
+      AppendTagged(fp, 's', static_cast<uint64_t>(row.start));
+      AppendTagged(fp, 'e', static_cast<uint64_t>(row.end));
+    }
+  } else {
+    AppendTagged(fp, 'K', string("plain"));
+  }
+}
+
+string MakeFingerprint(Session* session) {
+  string fp;
+  Schema* schema = session->schema();
+  Context* ctx = session->context();
+  AppendTagged(&fp, 'H', schema ? schema->schema_id() : string());
+  AppendTagged(&fp, 'I', ctx ? ctx->input() : string());
+  if (!ctx)
+    return fp;
+  // An edit that restores the same bytes must still retire the old payloads.
+  // Caret motion also changes the active segment and the candidate view, while
+  // candidate highlighting alone deliberately leaves the generation unchanged.
+  AppendTagged(&fp, 'r', ctx->input_revision());
+  AppendTagged(&fp, 'p', static_cast<uint64_t>(ctx->caret_pos()));
+  const auto& composition = ctx->composition();
+  AppendTagged(&fp, 'G', static_cast<uint64_t>(composition.size()));
+  for (const auto& segment : composition) {
+    AppendTagged(&fp, 'B', static_cast<uint64_t>(segment.start));
+    AppendTagged(&fp, 'D', static_cast<uint64_t>(segment.end));
+    if (!segment.menu) {
+      AppendTagged(&fp, 'M', uint64_t{0});
+      continue;
+    }
+    AppendTagged(&fp, 'M', static_cast<uint64_t>(
+                               reinterpret_cast<uintptr_t>(segment.menu.get())));
+    size_t page_size = schema ? static_cast<size_t>(schema->page_size()) : 5;
+    size_t want = (std::max)(segment.menu->candidate_count(), page_size);
+    segment.menu->Prepare(want);
+    AppendTagged(&fp, 'Q', static_cast<uint64_t>(segment.menu->candidate_count()));
+    for (size_t i = 0; i < segment.menu->candidate_count(); ++i) {
+      FingerprintCandidate(&fp, segment.menu->GetCandidateAt(i));
+    }
+  }
+  return fp;
+}
+
+uint32_t TouchGeneration(SessionId session_id, Session* session) {
+  string fp = MakeFingerprint(session);
+  auto& state = g_sessions[session_id];
+  if (state.fingerprint != fp) {
+    ++state.generation;
+    if (state.generation == 0)
+      ++state.generation;
+    state.fingerprint = std::move(fp);
+    state.layout = SpatialLayout{};
+    state.retired_frames.clear();
+  }
+  return state.generation;
+}
+
+struct ExportItem {
+  uint32_t id = 0;
+  uint32_t source_id = 0;
+  uint32_t attached_to_id = 0;
+  ItemKind kind = ItemKind::kOutput;
+  string label;
+  string comment;
+  string text;
+  string action;
+  string hint;
+  string style_key;
+  int start = 0;
+  int end = 0;
+  int menu_index = -1;
+  uint32_t rod_id = 0;
+  int rod_index = -1;
+  an<Candidate> payload;
+  InteractionCandidate* source_ptr = nullptr;
+  InteractionCandidate* parent_ptr = nullptr;
+};
+
+void FillFromCandidate(ExportItem* dest, const an<Candidate>& cand) {
+  dest->label = cand ? cand->text() : string();
+  dest->comment = cand ? cand->comment() : string();
+  dest->text = cand ? cand->text() : string();
+  dest->start = cand ? static_cast<int>(cand->start()) : 0;
+  dest->end = cand ? static_cast<int>(cand->end()) : 0;
+  dest->payload = cand;
+  dest->kind = ItemKind::kOutput;
+  dest->action = ActionName(dest->kind);
+}
+
+void FillFromInteraction(ExportItem* dest, const an<InteractionCandidate>& item) {
+  dest->kind = item->kind();
+  dest->label = item->label();
+  dest->comment = item->comment();
+  dest->text = item->text();
+  dest->start = static_cast<int>(item->start());
+  dest->end = static_cast<int>(item->end());
+  dest->payload = item;
+  dest->action = ActionName(item->kind());
+  dest->source_ptr = item->source().get();
+  dest->style_key = item->style_key();
+}
+
+void FillFromMenuCandidate(ExportItem* dest, const an<Candidate>& cand) {
+  auto interaction = AsInteraction(cand);
+  if (!interaction) {
+    FillFromCandidate(dest, cand);
+    return;
+  }
+  dest->kind = interaction->kind();
+  dest->action = ActionName(interaction->kind());
+  dest->source_ptr = interaction->source().get();
+  dest->style_key = interaction->style_key();
+  dest->payload = cand;
+  dest->text = cand->text();
+  dest->comment = cand->comment();
+  dest->start = static_cast<int>(cand->start());
+  dest->end = static_cast<int>(cand->end());
+  if (interaction->label_explicit())
+    dest->label = interaction->label();
+  else
+    dest->label = cand->text();
+}
+
+void FillFromAttachment(ExportItem* dest,
+                        const Attachment& row,
+                        InteractionCandidate* parent) {
+  dest->kind = row.kind;
+  dest->label = row.label;
+  dest->comment = row.comment;
+  dest->hint = row.hint;
+  dest->style_key = row.style_key;
+  dest->text = row.payload ? row.payload->text() : string();
+  dest->start = static_cast<int>(row.start);
+  dest->end = static_cast<int>(row.end);
+  dest->payload = row.payload;
+  dest->action = ActionName(row.kind);
+  dest->parent_ptr = parent;
+  dest->source_ptr = parent && parent->source() ? parent->source().get()
+                                                : parent;
+}
+
+}  // namespace
+
+RimeInteractionSnapshot* GetSnapshot(SessionId session_id) {
+  an<Session> session = Service::instance().GetSession(session_id);
+  if (!session)
+    return nullptr;
+
+  std::lock_guard<std::mutex> lock(g_mutex);
+  uint32_t generation = TouchGeneration(session_id, session.get());
+
+  vector<ExportItem> exported;
+  std::unordered_map<InteractionCandidate*, uint32_t> ids;
+  auto add_item = [&](ExportItem item) {
+    item.id = static_cast<uint32_t>(exported.size() + 1);
+    if (auto interaction = AsInteraction(item.payload))
+      ids[interaction.get()] = item.id;
+    exported.push_back(std::move(item));
+    return exported.back().id;
+  };
+
+  Context* ctx = session->context();
+  Schema* schema = session->schema();
+  if (ctx && ctx->HasMenu()) {
+    Segment& segment = ctx->composition().back();
+    if (segment.menu) {
+      size_t page_size = schema ? static_cast<size_t>(schema->page_size()) : 5;
+      size_t want = (std::max)(segment.menu->candidate_count(), page_size);
+      segment.menu->Prepare(want);
+      std::unordered_set<InteractionCandidate*> on_menu;
+      for (size_t i = 0; i < segment.menu->candidate_count(); ++i) {
+        if (auto interaction = AsInteraction(segment.menu->GetCandidateAt(i)))
+          on_menu.insert(interaction.get());
+      }
+      for (size_t i = 0; i < segment.menu->candidate_count(); ++i) {
+        auto interaction = AsInteraction(segment.menu->GetCandidateAt(i));
+        if (!interaction || !interaction->source())
+          continue;
+        auto source = interaction->source();
+        if (on_menu.count(source.get()) || ids.count(source.get()))
+          continue;
+        ExportItem item;
+        FillFromInteraction(&item, source);
+        item.menu_index = -1;
+        add_item(std::move(item));
+      }
+      for (size_t i = 0; i < segment.menu->candidate_count(); ++i) {
+        an<Candidate> cand = segment.menu->GetCandidateAt(i);
+        ExportItem item;
+        FillFromMenuCandidate(&item, cand);
+        auto interaction = AsInteraction(cand);
+        item.menu_index = static_cast<int>(i);
+        uint32_t parent_id = add_item(std::move(item));
+        if (!interaction)
+          continue;
+        int rod_index = 0;
+        for (const auto& row : interaction->attachments()) {
+          ExportItem rod;
+          FillFromAttachment(&rod, row, interaction.get());
+          rod.menu_index = -1;
+          rod.rod_id = parent_id;
+          rod.rod_index = rod_index++;
+          rod.attached_to_id = parent_id;
+          add_item(std::move(rod));
+        }
+      }
+    }
+  }
+
+  for (auto& item : exported) {
+    if (item.source_ptr) {
+      auto it = ids.find(item.source_ptr);
+      if (it != ids.end())
+        item.source_id = it->second;
+    }
+    if (item.parent_ptr) {
+      auto it = ids.find(item.parent_ptr);
+      if (it != ids.end())
+        item.attached_to_id = it->second;
+    }
+  }
+
+  the<SnapshotHolder> holder(new SnapshotHolder);
+  RIME_STRUCT_INIT(RimeInteractionSnapshot, holder->view);
+  holder->view.api_version = RIME_INTERACTION_API_VERSION;
+  holder->view.generation = generation;
+  holder->view.session_id = session_id;
+  holder->view.schema_id = DupStr(schema ? schema->schema_id() : string());
+  holder->view.input = DupStr(ctx ? ctx->input() : string());
+  holder->view.item_count = static_cast<int>(exported.size());
+  holder->view.active_item_id = 0;
+  holder->session_id = session_id;
+  holder->generation = generation;
+  if (ctx && ctx->HasMenu()) {
+    Segment& live = ctx->composition().back();
+    holder->menu = live.menu;
+    if (live.HasAlternate() && live.alternate_item_id) {
+      holder->view.active_item_id = live.alternate_item_id;
+    } else {
+      for (const auto& src : exported) {
+        if (src.menu_index >= 0 &&
+            src.menu_index == static_cast<int>(live.selected_index)) {
+          holder->view.active_item_id = src.id;
+          break;
+        }
+      }
+    }
+  }
+  if (!exported.empty()) {
+    holder->view.items = new RimeInteractionItem[exported.size()];
+    std::memset(holder->view.items, 0,
+                sizeof(RimeInteractionItem) * exported.size());
+    for (size_t i = 0; i < exported.size(); ++i) {
+      const ExportItem& src = exported[i];
+      RimeInteractionItem& dest = holder->view.items[i];
+      dest.id = src.id;
+      dest.source_id = src.source_id;
+      dest.attached_to_id = src.attached_to_id;
+      dest.kind = static_cast<int>(src.kind);
+      dest.label = DupStr(src.label);
+      dest.comment = DupStr(src.comment);
+      dest.text = DupStr(src.text);
+      dest.action = DupStr(src.action);
+      dest.hint = DupStr(src.hint);
+      dest.start = src.start;
+      dest.end = src.end;
+      dest.menu_index = src.menu_index;
+      dest.rod_id = src.rod_id;
+      dest.rod_index = src.rod_index;
+      holder->payloads.push_back(src.payload);
+      holder->style_keys.push_back(src.style_key);
+    }
+  }
+
+  SnapshotHolder* raw = holder.release();
+  g_holders.insert(raw);
+  return &raw->view;
+}
+
+void FreeSnapshot(RimeInteractionSnapshot* snapshot) {
+  if (!snapshot)
+    return;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto* holder = reinterpret_cast<SnapshotHolder*>(snapshot);
+  auto it = g_holders.find(holder);
+  if (it == g_holders.end())
+    return;
+  g_holders.erase(it);
+  ClearView(&holder->view);
+  delete holder;
+}
+
+Bool SnapshotIsCurrent(SessionId session_id,
+                       const RimeInteractionSnapshot* snapshot) {
+  if (!snapshot)
+    return False;
+  an<Session> session = Service::instance().GetSession(session_id);
+  if (!session)
+    return False;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto* holder = reinterpret_cast<SnapshotHolder*>(
+      const_cast<RimeInteractionSnapshot*>(snapshot));
+  if (g_holders.find(holder) == g_holders.end())
+    return False;
+  if (!holder->valid || holder->session_id != session_id)
+    return False;
+  uint32_t generation = TouchGeneration(session_id, session.get());
+  return Bool(snapshot->session_id == session_id &&
+              snapshot->generation == generation &&
+              holder->generation == generation);
+}
+
+struct ItemTarget {
+  an<Candidate> payload;
+  int menu_index = -1;
+  int anchor_index = -1;
+};
+
+static int LookupPayload(SessionId session_id,
+                         RimeInteractionSnapshot* snapshot,
+                         uint32_t item_id,
+                         ItemTarget* target) {
+  if (!snapshot || item_id == 0 || !target)
+    return kRimeInteractionInvalid;
+  an<Session> session = Service::instance().GetSession(session_id);
+  if (!session || !session->context())
+    return kRimeInteractionInvalid;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto* holder = reinterpret_cast<SnapshotHolder*>(snapshot);
+  if (g_holders.find(holder) == g_holders.end())
+    return kRimeInteractionInvalid;
+  if (!holder->valid)
+    return kRimeInteractionExpired;
+  if (snapshot->session_id != session_id || holder->session_id != session_id)
+    return kRimeInteractionInvalid;
+  uint32_t generation = TouchGeneration(session_id, session.get());
+  if (snapshot->generation != generation || holder->generation != generation)
+    return kRimeInteractionExpired;
+  const string& input = session->context()->input();
+  if (snapshot->input && input != snapshot->input)
+    return kRimeInteractionExpired;
+  int found = -1;
+  for (int i = 0; i < snapshot->item_count; ++i) {
+    if (snapshot->items[i].id == item_id) {
+      found = i;
+      break;
+    }
+  }
+  if (found < 0)
+    return kRimeInteractionInvalid;
+  const RimeInteractionItem& item = snapshot->items[found];
+  if (item.start < 0 || item.end < item.start ||
+      static_cast<size_t>(item.end) > input.size()) {
+    return kRimeInteractionExpired;
+  }
+  auto utf8_boundary = [](const string& s, size_t pos) {
+    if (pos > s.size())
+      return false;
+    if (pos == 0 || pos == s.size())
+      return true;
+    return (static_cast<unsigned char>(s[pos]) & 0xC0) != 0x80;
+  };
+  if (!utf8_boundary(input, static_cast<size_t>(item.start)) ||
+      !utf8_boundary(input, static_cast<size_t>(item.end))) {
+    return kRimeInteractionInvalid;
+  }
+  const char* action = item.action ? item.action : "";
+  if (item.kind == kRimeInteractionKindNotice ||
+      std::strcmp(action, "commit") != 0 ||
+      found >= static_cast<int>(holder->payloads.size()) ||
+      !holder->payloads[found]) {
+    return kRimeInteractionNotOutput;
+  }
+  an<Candidate> payload = holder->payloads[found];
+  if (payload->start() != static_cast<size_t>(item.start) ||
+      payload->end() != static_cast<size_t>(item.end)) {
+    return kRimeInteractionExpired;
+  }
+  if (session->context()->composition().empty())
+    return kRimeInteractionInvalid;
+  const Segment& seg = session->context()->composition().back();
+  if (seg.status >= Segment::kSelected)
+    return kRimeInteractionExpired;
+  const bool atomic = HasAtomicCandidate(payload);
+  // Whole-input results are explicit, context-bound candidates.  Do not grant
+  // ordinary candidates wider coverage merely because they claim that range.
+  if (atomic &&
+      (!session->context()->IsAtomicCandidateCurrent(payload) ||
+       item.start != 0 || static_cast<size_t>(item.end) != input.size())) {
+    return kRimeInteractionExpired;
+  }
+  if (!atomic && (static_cast<size_t>(item.start) < seg.start ||
+                  static_cast<size_t>(item.end) > seg.end)) {
+    return kRimeInteractionExpired;
+  }
+  target->payload = payload;
+  target->menu_index = item.menu_index;
+  target->anchor_index = item.menu_index;
+  if (item.menu_index < 0) {
+    if (!item.attached_to_id)
+      return kRimeInteractionInvalid;
+    for (int i = 0; i < snapshot->item_count; ++i) {
+      if (snapshot->items[i].id == item.attached_to_id) {
+        target->anchor_index = snapshot->items[i].menu_index;
+        break;
+      }
+    }
+    if (target->anchor_index < 0)
+      return kRimeInteractionInvalid;
+  }
+  return kRimeInteractionOk;
+}
+
+static void RememberActive(RimeInteractionSnapshot* snapshot, uint32_t item_id) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto* holder = reinterpret_cast<SnapshotHolder*>(snapshot);
+  if (g_holders.find(holder) != g_holders.end() && holder->valid)
+    holder->view.active_item_id = item_id;
+}
+
+int HighlightItem(SessionId session_id,
+                  RimeInteractionSnapshot* snapshot,
+                  uint32_t item_id) {
+  ItemTarget target;
+  int status = LookupPayload(session_id, snapshot, item_id, &target);
+  if (status != kRimeInteractionOk)
+    return status;
+  an<Session> session = Service::instance().GetSession(session_id);
+  if (!session || !session->context())
+    return kRimeInteractionInvalid;
+  Context* ctx = session->context();
+  if (target.menu_index >= 0) {
+    ctx->Highlight(static_cast<size_t>(target.menu_index));
+  } else {
+    ctx->Highlight(static_cast<size_t>(target.anchor_index));
+    if (!ctx->HighlightAlternate(target.payload, item_id))
+      return kRimeInteractionInvalid;
+  }
+  RememberActive(snapshot, item_id);
+  return kRimeInteractionOk;
+}
+
+int SelectItem(SessionId session_id,
+               RimeInteractionSnapshot* snapshot,
+               uint32_t item_id) {
+  ItemTarget target;
+  int status = LookupPayload(session_id, snapshot, item_id, &target);
+  if (status != kRimeInteractionOk)
+    return status;
+  an<Session> session = Service::instance().GetSession(session_id);
+  if (!session || !session->context())
+    return kRimeInteractionInvalid;
+  Context* ctx = session->context();
+  if (target.menu_index >= 0) {
+    if (!ctx->Select(static_cast<size_t>(target.menu_index)))
+      return kRimeInteractionInvalid;
+  } else {
+    ctx->Highlight(static_cast<size_t>(target.anchor_index));
+    if (!ctx->SelectAlternate(target.payload, item_id))
+      return kRimeInteractionInvalid;
+  }
+  RememberActive(snapshot, item_id);
+  return kRimeInteractionOk;
+}
+
+const char* GetItemStyle(const RimeInteractionSnapshot* snapshot,
+                          uint32_t item_id) {
+  if (!snapshot || !item_id)
+    return nullptr;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto* holder = reinterpret_cast<const SnapshotHolder*>(snapshot);
+  if (!g_holders.count(const_cast<SnapshotHolder*>(holder)))
+    return nullptr;
+  for (int i = 0; i < holder->view.item_count; ++i)
+    if (holder->view.items[i].id == item_id &&
+        static_cast<size_t>(i) < holder->style_keys.size())
+      return holder->style_keys[i].c_str();
+  return nullptr;
+}
+
+RimeInteractionPreedit* GetPreeditPresentation(SessionId session_id) {
+  auto session = Service::instance().GetSession(session_id);
+  if (!session || !session->context())
+    return nullptr;
+  auto* ctx = session->context();
+  const auto preedit = ctx->GetPreedit();
+  const auto regions = ctx->GetPreeditRegions();
+  if (preedit.text.size() > 128 * 1024 || regions.size() > 192)
+    return nullptr;
+  auto* value = new RimeInteractionPreedit{};
+  RIME_STRUCT_INIT(RimeInteractionPreedit, *value);
+  value->text = DupStr(preedit.text);
+  value->span_count = static_cast<int>(regions.size());
+  value->spans = new RimeInteractionTextSpan[regions.size()]{};
+  for (size_t i = 0; i < regions.size(); ++i) {
+    const auto& region = regions[i];
+    value->spans[i].start = static_cast<int>(region.start);
+    value->spans[i].end = static_cast<int>(region.end);
+    value->spans[i].style_key = DupStr(region.style_key);
+    value->spans[i].highlightable = region.highlightable ? True : False;
+  }
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_preedits.insert(value);
+  return value;
+}
+
+void FreePreeditPresentation(RimeInteractionPreedit* value) {
+  if (!value)
+    return;
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_preedits.erase(value))
+    DestroyPreedit(value);
+}
+
+namespace {
+// Caller holds g_mutex. Layout publication changes no Context property and
+// sends no notifier, so a pre-key report cannot re-enter composition/UI work.
+int CurrentLayoutSnapshot(SessionId sid, const RimeInteractionSnapshot* snapshot,
+                           Session* session, SnapshotHolder** result) {
+  if (!snapshot || !session || !session->context())
+    return kRimeInteractionInvalid;
+  auto* holder = reinterpret_cast<SnapshotHolder*>(
+      const_cast<RimeInteractionSnapshot*>(snapshot));
+  if (!g_holders.count(holder))
+    return kRimeInteractionInvalid;
+  if (holder->session_id != sid || holder->view.session_id != sid)
+    return kRimeInteractionInvalid;
+  if (!holder->valid || TouchGeneration(sid, session) != holder->generation ||
+      holder->view.generation != holder->generation)
+    return kRimeInteractionExpired;
+  *result = holder;
+  return kRimeInteractionOk;
+}
+
+const RimeInteractionItem* FindItem(const SnapshotHolder& holder, uint32_t id) {
+  for (int i = 0; i < holder.view.item_count; ++i)
+    if (holder.view.items[i].id == id)
+      return &holder.view.items[i];
+  return nullptr;
+}
+
+bool IsOutput(const RimeInteractionItem& item) {
+  return item.kind != kRimeInteractionKindNotice && item.action &&
+         std::strcmp(item.action, "commit") == 0;
+}
+
+int64_t CenterX2(const SpatialNode& node) {
+  return int64_t(node.rect.left) + node.rect.right;
+}
+int64_t CenterY2(const SpatialNode& node) {
+  return int64_t(node.rect.top) + node.rect.bottom;
+}
+void RetireFrame(SessionState* state) {
+  if (state->layout.frame_token) {
+    state->retired_frames.push_back(state->layout.frame_token);
+    if (state->retired_frames.size() > 32)
+      state->retired_frames.erase(state->retired_frames.begin());
+  }
+  state->layout = SpatialLayout{};
+}
+}  // namespace
+
+int SetLayout(SessionId session_id, const RimeInteractionSnapshot* snapshot,
+                uint64_t frame_token, uint64_t layout_revision,
+                const RimeInteractionRect* rectangles, int rectangle_count) {
+  constexpr int kMaxRectangles = 256;
+  constexpr int kCoordinateLimit = 1000000;
+  if (!frame_token || !layout_revision || rectangle_count < 0 ||
+      rectangle_count > kMaxRectangles || (rectangle_count && !rectangles))
+    return kRimeInteractionInvalid;
+  auto session = Service::instance().GetSession(session_id);
+  std::lock_guard<std::mutex> lock(g_mutex);
+  SnapshotHolder* holder = nullptr;
+  const int status = CurrentLayoutSnapshot(session_id, snapshot, session.get(),
+                                            &holder);
+  if (status != kRimeInteractionOk)
+    return status;
+  auto& state = g_sessions[session_id];
+  if (std::find(state.retired_frames.begin(), state.retired_frames.end(),
+                frame_token) != state.retired_frames.end() ||
+      (state.layout.frame_token == frame_token &&
+       layout_revision <= state.layout.revision))
+    return kRimeInteractionExpired;
+  SpatialLayout next;
+  next.generation = holder->generation;
+  next.frame_token = frame_token;
+  next.revision = layout_revision;
+  std::unordered_set<uint32_t> ids;
+  for (int i = 0; i < rectangle_count; ++i) {
+    const auto& rect = rectangles[i];
+    const auto* item = FindItem(*holder, rect.item_id);
+    if (!item || !IsOutput(*item) || !ids.insert(rect.item_id).second ||
+        rect.left < -kCoordinateLimit || rect.top < -kCoordinateLimit ||
+        rect.right > kCoordinateLimit || rect.bottom > kCoordinateLimit ||
+        rect.left >= rect.right || rect.top >= rect.bottom)
+      return kRimeInteractionInvalid;
+    const bool rod = item->menu_index < 0;
+    if (rod && (!item->attached_to_id || !item->rod_id))
+      return kRimeInteractionInvalid;
+    next.nodes.push_back({rect, rod ? item->attached_to_id : item->id, rod});
+  }
+  // Every measured lower item belongs to a measured main item. Off-page
+  // source references cannot become accidental spatial targets.
+  for (const auto& node : next.nodes) {
+    if (!node.rod)
+      continue;
+    auto anchor = std::find_if(next.nodes.begin(), next.nodes.end(),
+        [&](const SpatialNode& value) {
+          return !value.rod && value.rect.item_id == node.anchor;
+        });
+    if (anchor == next.nodes.end())
+      return kRimeInteractionInvalid;
+  }
+  if (state.layout.frame_token && state.layout.frame_token != frame_token)
+    RetireFrame(&state);
+  state.layout = std::move(next);
+  return kRimeInteractionOk;
+}
+
+int NeighborItem(SessionId session_id, const RimeInteractionSnapshot* snapshot,
+                   uint32_t item_id, int direction, uint32_t* target_id) {
+  if (target_id)
+    *target_id = 0;
+  if (!target_id || !item_id || direction < kRimeInteractionLeft ||
+      direction > kRimeInteractionDown)
+    return kRimeInteractionInvalid;
+  auto session = Service::instance().GetSession(session_id);
+  std::lock_guard<std::mutex> lock(g_mutex);
+  SnapshotHolder* holder = nullptr;
+  const int status = CurrentLayoutSnapshot(session_id, snapshot, session.get(),
+                                            &holder);
+  if (status != kRimeInteractionOk)
+    return status;
+  const auto& layout = g_sessions[session_id].layout;
+  if (layout.generation != holder->generation || layout.nodes.empty())
+    return kRimeInteractionExpired;
+  const SpatialNode* current = nullptr;
+  const SpatialNode* current_header = nullptr;
+  for (const auto& node : layout.nodes)
+    if (node.rect.item_id == item_id)
+      current = &node;
+  if (!current)
+    return kRimeInteractionInvalid;
+  for (const auto& node : layout.nodes)
+    if (!node.rod && node.rect.item_id == current->anchor)
+      current_header = &node;
+  if (!current_header)
+    return kRimeInteractionInvalid;
+  const SpatialNode* target = nullptr;
+  int64_t distance = (std::numeric_limits<int64_t>::max)();
+  if (direction == kRimeInteractionUp || direction == kRimeInteractionDown) {
+    // Up from the top output returns its main item. Notices are not targets;
+    // neither motion nor an absent item silently wraps to a different column.
+    for (const auto& node : layout.nodes) {
+      if (node.anchor != current->anchor || node.rect.item_id == item_id)
+        continue;
+      const int64_t delta = CenterY2(node) - CenterY2(*current);
+      if ((direction == kRimeInteractionUp && delta >= 0) ||
+          (direction == kRimeInteractionDown && delta <= 0))
+        continue;
+      const int64_t candidate_distance = delta < 0 ? -delta : delta;
+      if (candidate_distance < distance) {
+        target = &node;
+        distance = candidate_distance;
+      }
+    }
+  } else {
+    // First choose the immediately adjacent visible column in this main band.
+    // A short/empty adjacent rod is a wall, never a reason to skip over it.
+    const SpatialNode* adjacent = nullptr;
+    for (const auto& header : layout.nodes) {
+      if (header.rod || header.anchor == current->anchor ||
+          header.rect.top >= current_header->rect.bottom ||
+          header.rect.bottom <= current_header->rect.top)
+        continue;
+      const int64_t delta = CenterX2(header) - CenterX2(*current_header);
+      if ((direction == kRimeInteractionLeft && delta >= 0) ||
+          (direction == kRimeInteractionRight && delta <= 0))
+        continue;
+      const int64_t candidate_distance = delta < 0 ? -delta : delta;
+      if (candidate_distance < distance) {
+        adjacent = &header;
+        distance = candidate_distance;
+      }
+    }
+    if (adjacent) {
+      distance = (std::numeric_limits<int64_t>::max)();
+      const int64_t y = CenterY2(*current);
+      for (const auto& node : layout.nodes) {
+        if (node.anchor != adjacent->anchor || node.rod != current->rod ||
+            2 * int64_t(node.rect.top) > y ||
+            2 * int64_t(node.rect.bottom) <= y)
+          continue;
+        const int64_t delta = CenterY2(node) - y;
+        const int64_t candidate_distance = delta < 0 ? -delta : delta;
+        if (candidate_distance < distance) {
+          target = &node;
+          distance = candidate_distance;
+        }
+      }
+    }
+  }
+  if (target)
+    *target_id = target->rect.item_id;
+  return kRimeInteractionOk;
+}
+
+void ClearLayout(SessionId session_id) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  auto found = g_sessions.find(session_id);
+  if (found != g_sessions.end())
+    RetireFrame(&found->second);
+}
+
+void ForgetSession(SessionId session_id) {
+  // Keep exported strings/items readable until FreeSnapshot, but never allow a
+  // retired snapshot to revive if a Session address and generation are reused.
+  // Candidate/Menu destructors can run Lua finalizers, so release them only
+  // after the interaction lock has been dropped.
+  vector<vector<an<Candidate>>> retired_payloads;
+  vector<an<Menu>> retired_menus;
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_sessions.erase(session_id);
+    for (auto* holder : g_holders) {
+      if (holder->session_id != session_id || !holder->valid)
+        continue;
+      holder->valid = false;
+      retired_payloads.push_back(std::move(holder->payloads));
+      retired_menus.push_back(std::move(holder->menu));
+    }
+  }
+}
+
+void ResetSnapshotState() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_sessions.clear();
+  for (auto* holder : g_holders) {
+    ClearView(&holder->view);
+    delete holder;
+  }
+  g_holders.clear();
+  for (auto* value : g_preedits)
+    DestroyPreedit(value);
+  g_preedits.clear();
+}
+
+}  // namespace interaction
+}  // namespace rime
