+                         const Candidate& appearance)
+    : ShadowCandidate(genuine,
+                      appearance.type(),
+                      appearance.text(),
+                      appearance.comment(),
+                      false) {
+  set_start(appearance.start());
+  set_end(appearance.end());
+  set_quality(appearance.quality());
+  preedit_ = appearance.preedit();
+}
+
+string HeldPayload::preedit() const {
+  return preedit_;
+}
+
+static bool SameAppearance(const Candidate& a, const Candidate& b) {
+  return a.text() == b.text() && a.comment() == b.comment() &&
+         a.preedit() == b.preedit() && a.type() == b.type() &&
+         a.start() == b.start() && a.end() == b.end() &&
+         a.quality() == b.quality();
+}
+
+an<Candidate> AcyclicPayload(const an<Candidate>& cand) {
+  if (!cand)
+    return nullptr;
+  if (auto atomic = As<AtomicCandidate>(cand)) {
+    auto inner = AcyclicPayload(atomic->item());
+    return inner ? atomic->WithPayload(inner) : nullptr;
+  }
+  if (auto item = As<InteractionCandidate>(cand)) {
+    auto inner = AcyclicPayload(item->item());
+    if (!inner || SameAppearance(*cand, *inner))
+      return inner;
+    return New<HeldPayload>(inner, *cand);
+  }
+  if (auto uniquified = As<UniquifiedCandidate>(cand)) {
+    if (uniquified->items().empty())
+      return nullptr;
+    CandidateList genuines;
+    genuines.reserve(uniquified->items().size());
+    for (const auto& it : uniquified->items()) {
+      auto held = AcyclicPayload(it);
+      if (!held)
+        return nullptr;
+      genuines.push_back(held);
+    }
+    auto rebuilt = New<UniquifiedCandidate>(
+        genuines.front(), cand->type(), cand->text(), cand->comment());
+    for (size_t i = 1; i < genuines.size(); ++i)
+      rebuilt->Append(genuines[i]);
+    rebuilt->set_start(cand->start());
+    rebuilt->set_end(cand->end());
+    rebuilt->set_quality(cand->quality());
+    if (SameAppearance(*rebuilt, *cand))
+      return rebuilt;
+    return New<HeldPayload>(rebuilt, *cand);
+  }
+  if (auto shadow = As<ShadowCandidate>(cand)) {
+    auto inner = AcyclicPayload(shadow->item());
+    if (!inner)
+      return nullptr;
+    if (SameAppearance(*cand, *inner))
+      return inner;
+    return New<HeldPayload>(inner, *cand);
+  }
+  return cand;
+}
+
+bool InteractionCandidate::Attach(Attachment attachment) {
+  if (attachment.kind == ItemKind::kNotice) {
+    attachment.payload.reset();
+    if (attachment.start == 0 && attachment.end == 0) {
+      attachment.start = start();
+      attachment.end = end();
+    }
+  } else {
+    if (attachment.payload)
+      attachment.payload = AcyclicPayload(attachment.payload);
+    if (!attachment.payload)
+      return false;
+    attachment.start = attachment.payload->start();
+    attachment.end = attachment.payload->end();
+  }
+  if (attachment.label.empty() && attachment.payload)
+    attachment.label = attachment.payload->text();
+  attachments_.push_back(std::move(attachment));
+  return true;
+}
+
+an<InteractionCandidate> AsInteraction(const an<Candidate>& cand) {
+  an<Candidate> cur = cand;
+  for (int depth = 0; cur && depth < 16; ++depth) {
+    if (auto item = As<InteractionCandidate>(cur))
+      return item;
+    if (auto uniquified = As<UniquifiedCandidate>(cur)) {
+      if (uniquified->items().size() != 1)
+        return nullptr;
+      cur = uniquified->items().front();
+      continue;
+    }
+    if (auto shadow = As<ShadowCandidate>(cur)) {
+      cur = shadow->item();
+      continue;
+    }
+    break;
+  }
+  return nullptr;
+}
+
+}  // namespace interaction
+}  // namespace rime
