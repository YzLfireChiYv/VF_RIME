+
+an<AtomicCandidate> AtomicCandidate::WithPayload(an<Candidate> payload) const {
+  return New<AtomicCandidate>(std::move(payload), instance_id_, input_revision_,
+                              input_, mode_);
+}
+
+namespace {
+bool ContainsAtomic(const an<Candidate>& candidate, int depth) {
+  if (!candidate)
+    return false;
+  if (depth >= 32)
+    return true;  // Unknown deep scope is rejected, never downgraded to plain.
+  if (As<AtomicCandidate>(candidate))
+    return true;
+  if (auto unique = As<UniquifiedCandidate>(candidate)) {
+    for (const auto& item : unique->items())
+      if (ContainsAtomic(item, depth + 1))
+        return true;
+  } else if (auto shadow = As<ShadowCandidate>(candidate)) {
+    return ContainsAtomic(shadow->item(), depth + 1);
+  }
+  return false;
+}
+}  // namespace
+
+bool HasAtomicCandidate(const an<Candidate>& candidate) {
+  return ContainsAtomic(candidate, 0);
+}
+
+an<AtomicCandidate> AsAtomicCandidate(const an<Candidate>& candidate) {
+  an<Candidate> current = candidate;
+  for (int depth = 0; current && depth < 32; ++depth) {
+    if (auto atomic = As<AtomicCandidate>(current))
+      return atomic;
+    if (auto unique = As<UniquifiedCandidate>(current)) {
+      if (unique->items().size() != 1)
+        return nullptr;
+      current = unique->items().front();
+    } else if (auto shadow = As<ShadowCandidate>(current)) {
+      current = shadow->item();
+    } else {
+      break;
+    }
+  }
+  return nullptr;
+}
