diff --git a/src/rime_interaction_api.h b/src/rime_interaction_api.h
new file mode 100644
index 0000000000000000000000000000000000000000..f32eedc063c20537a1cea4a816500cef721473e0
--- /dev/null
+++ b/src/rime_interaction_api.h
@@ -0,0 +1,172 @@
+/*
+ * Copyright RIME Developers
+ * Distributed under the BSD License
+ *
+ * Interaction snapshot extension API (rod data chain, v2).
+ * Obtained via RimeFindModule("interaction")->get_api().
+ * This header does not add members to RimeApi.
+ */
+#ifndef RIME_INTERACTION_API_H_
+#define RIME_INTERACTION_API_H_
+
+#include "rime_api.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RIME_INTERACTION_API_VERSION 2
+
+enum RimeInteractionStatus {
+  kRimeInteractionInvalid = 0,
+  kRimeInteractionOk = 1,
+  kRimeInteractionExpired = 2,
+  kRimeInteractionNotOutput = 3
+};
+
+/* Item kind. C++ enum rime::interaction::ItemKind uses the same values. */
+enum RimeInteractionKind {
+  kRimeInteractionKindNone = 0,
+  kRimeInteractionKindSource = 1,      /* source, Lua kind "source" */
+  kRimeInteractionKindAssociated = 2,  /* associated, Lua kind "associated" */
+  kRimeInteractionKindNotice = 3,      /* rod notice, Lua kind "notice", not committable */
+  kRimeInteractionKindOutput = 4       /* committable output, Lua kind "output"; also plain items */
+};
+
+/*
+ * Snapshot item. Public id is a positive integer local to this snapshot.
+ * 0 in source_id / attached_to_id means "none".
+ *
+ * C++ / Lua correspondence:
+ *   id            <- assigned at export; not a pointer
+ *   source_id     <- InteractionCandidate::source()
+ *   attached_to_id<- rod parent
+ *   kind          <- ItemKind / opts.kind
+ *   label         <- InteractionCandidate::label() or Candidate::text()
+ *   comment       <- display comment metadata
+ *   text          <- Candidate::text() of the real payload (empty for notice)
+ *   action        <- "commit" or "notice"
+ *   start, end    <- UTF-8 byte range in current input
+ *   menu_index    <- index in prepared main menu, -1 if not on the page
+ *   rod_id        <- 0 if not a rod row; else the rod identity, derived
+ *                    from the mounted item's snapshot id (one rod per item)
+ *   rod_index     <- row order inside that rod, not an identity
+ *   hint          <- optional display-only prefix for a rod row; never payload
+ */
+typedef struct rime_interaction_item_t {
+  uint32_t id;
+  uint32_t source_id;
+  uint32_t attached_to_id;
+  int kind;
+  char* label;
+  char* comment;
+  char* text;
+  char* action;
+  int start;
+  int end;
+  int menu_index;
+  uint32_t rod_id;
+  int rod_index;
+  char* hint;
+} RimeInteractionItem;
+
+/*
+ * Versioned snapshot. Strings and items are valid until free_snapshot.
+ * generation changes when activatable content, input coverage, input text,
+ * or schema changes. Highlight / hover does not change generation or ids.
+ */
+typedef struct rime_interaction_snapshot_t {
+  int data_size;
+  int api_version;
+  uint32_t generation;
+  RimeSessionId session_id;
+  char* schema_id;
+  char* input;
+  int item_count;
+  RimeInteractionItem* items;
+  /* currently highlighted/selected item id; 0 if none. highlight does not
+   * change generation. */
+  uint32_t active_item_id;
+} RimeInteractionSnapshot;
+
+/* Optional v2 tail: final client-coordinate rectangles, never guessed by Lua.
+ * A layout belongs to one snapshot generation and an opaque frontend frame.
+ * No key bindings or default navigation policy are installed by this API. */
+typedef struct rime_interaction_rect_t {
+  uint32_t item_id;
+  int left;
+  int top;
+  int right;
+  int bottom;
+} RimeInteractionRect;
+
+enum RimeInteractionDirection {
+  kRimeInteractionLeft = 1,
+  kRimeInteractionRight = 2,
+  kRimeInteractionUp = 3,
+  kRimeInteractionDown = 4
+};
+
+/* UTF-8 display ranges. Text is the exact GetPreedit() presentation, including
+ * soft cursor/prompt. False highlightable keeps controls/Tips out of selection. */
+typedef struct rime_interaction_text_span_t {
+  int start;
+  int end;
+  char* style_key;
+  Bool highlightable;
+} RimeInteractionTextSpan;
+typedef struct rime_interaction_preedit_t {
+  int data_size;
+  char* text;
+  int span_count;
+  RimeInteractionTextSpan* spans;
+} RimeInteractionPreedit;
+
+typedef struct rime_interaction_api_t {
+  int data_size;
+  int api_version;
+
+  /* Caller owns the result and must call free_snapshot. NULL on failure. */
+  RimeInteractionSnapshot* (*get_snapshot)(RimeSessionId session_id);
+  void (*free_snapshot)(RimeInteractionSnapshot* snapshot);
+
+  /* True if session still has the same generation as this snapshot. */
+  Bool (*snapshot_is_current)(RimeSessionId session_id,
+                              const RimeInteractionSnapshot* snapshot);
+
+  /* Highlight or select by snapshot item id. Returns RimeInteractionStatus.
+   * Only kRimeInteractionOk means the action was taken. Notice items return
+   * kRimeInteractionNotOutput. Freed or foreign snapshots are invalid. */
+  int (*highlight_item)(RimeSessionId session_id,
+                        RimeInteractionSnapshot* snapshot,
+                        uint32_t item_id);
+  int (*select_item)(RimeSessionId session_id,
+                     RimeInteractionSnapshot* snapshot,
+                     uint32_t item_id);
+
+  /* Appended, size-checked facilities. The v2 item array ABI stays unchanged.
+   * Returned style key is snapshot-owned; empty/NULL means inherited style. */
+  const char* (*get_item_style)(const RimeInteractionSnapshot* snapshot,
+                                uint32_t item_id);
+  int (*set_layout)(RimeSessionId session_id,
+                     const RimeInteractionSnapshot* snapshot,
+                     uint64_t frame_token,
+                     uint64_t layout_revision,
+                     const RimeInteractionRect* rectangles,
+                     int rectangle_count);
+  /* Ok + target_id=0 means a wall. Expired means no current measured layout. */
+  int (*neighbor_item)(RimeSessionId session_id,
+                        const RimeInteractionSnapshot* snapshot,
+                        uint32_t item_id,
+                        int direction,
+                        uint32_t* target_id);
+  void (*clear_layout)(RimeSessionId session_id);
+  RimeInteractionPreedit* (*get_preedit)(RimeSessionId session_id);
+  void (*free_preedit)(RimeInteractionPreedit* preedit);
+} RimeInteractionApi;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  /* RIME_INTERACTION_API_H_ */
