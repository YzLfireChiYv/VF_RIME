index 43f0b418eefe68377416f03111e5311b3eac0a3a..d7a7339d4d5976d9618dc664170f11aa4384735e 100644
--- a/src/rime/context.cc
+++ b/src/rime/context.cc
@@ -5,9 +5,12 @@
 // 2011-05-08 GONG Chen <chen.sst@gmail.com>
 //
 #include <algorithm>
+#include <atomic>
+#include <sstream>
 #include <utility>
 #include <rime/candidate.h>
 #include <rime/context.h>
+#include <rime/interaction/candidate.h>
 #include <rime/menu.h>
 #include <rime/segmentation.h>
 
@@ -15,9 +18,233 @@ namespace rime {
 
 const string kSelectedBeforeEditing = "selected_before_editing";
 
+namespace {
+std::atomic<uint64_t> next_context_id{1};
+std::atomic<uint64_t> next_state_revision{1};
+constexpr size_t kMaxProjectionBytes = 64 * 1024;
+
+bool IsSynthesizedPayload(an<Candidate> candidate) {
+  for (int depth = 0; candidate && depth < 32; ++depth) {
+    if (auto shadow = As<ShadowCandidate>(candidate)) {
+      candidate = shadow->item();
+    } else if (auto unique = As<UniquifiedCandidate>(candidate)) {
+      if (unique->items().size() != 1)
+        return false;
+      candidate = unique->items().front();
+    } else {
+      return bool(As<SimpleCandidate>(candidate));
+    }
+  }
+  return false;
+}
+
+// Strict UTF-8, including rejection of overlong encodings and surrogates.
+bool Utf8Boundaries(const string& text, vector<bool>* boundaries) {
+  boundaries->assign(text.size() + 1, false);
+  size_t i = 0;
+  while (i < text.size()) {
+    (*boundaries)[i] = true;
+    const auto lead = static_cast<unsigned char>(text[i]);
+    size_t length = 0;
+    uint32_t codepoint = 0, minimum = 0;
+    if (lead < 0x80) { length = 1; codepoint = lead; }
+    else if (lead >= 0xc2 && lead <= 0xdf) {
+      length = 2; codepoint = lead & 0x1f; minimum = 0x80;
+    } else if (lead >= 0xe0 && lead <= 0xef) {
+      length = 3; codepoint = lead & 0x0f; minimum = 0x800;
+    } else if (lead >= 0xf0 && lead <= 0xf4) {
+      length = 4; codepoint = lead & 7; minimum = 0x10000;
+    } else { return false; }
+    if (i + length > text.size()) return false;
+    for (size_t j = 1; j < length; ++j) {
+      auto byte = static_cast<unsigned char>(text[i + j]);
+      if ((byte & 0xc0) != 0x80) return false;
+      codepoint = (codepoint << 6) | (byte & 0x3f);
+    }
+    if (codepoint < minimum || codepoint > 0x10ffff ||
+        (codepoint >= 0xd800 && codepoint <= 0xdfff) || codepoint == 0)
+      return false;
+    i += length;
+  }
+  (*boundaries)[text.size()] = true;
+  return true;
+}
+}  // namespace
+
+Context::Context()
+    : instance_id_(next_context_id.fetch_add(1)),
+      input_revision_(next_state_revision.fetch_add(1)),
+      view_revision_(next_state_revision.fetch_add(1)) {}
+
+void Context::InvalidateView(bool input_changed) {
+  if (input_changed)
+    input_revision_ = next_state_revision.fetch_add(1);
+  view_revision_ = next_state_revision.fetch_add(1);
+  ClearPreeditProjection();
+}
+
+void Context::ClearPreeditProjection() {
+  has_projection_ = false;
+  projection_ = PreeditProjection{};
+}
+
+bool Context::HasCurrentProjection() const {
+  return has_projection_ && projection_.input_revision == input_revision_ &&
+         projection_.view_revision == view_revision();
+}
+
+string Context::ProjectionSelectionKey() const {
+  // Native selector/editor paths can update Segment fields directly, without
+  // Context::Highlight. Observe those changes without forcing lazy menus.
+  std::ostringstream key;
+  for (const auto& segment : composition_) {
+    key << segment.start << ':' << segment.end << ':' << segment.status << ':'
+        << segment.selected_index << ':' << segment.menu.get() << ':'
+        << segment.alternate_candidate.get() << ':' << segment.alternate_item_id
+        << ';';
+  }
+  return key.str();
+}
+
+uint64_t Context::view_revision() const {
+  auto key = ProjectionSelectionKey();
+  if (key != observed_selection_key_) {
+    observed_selection_key_ = std::move(key);
+    view_revision_ = next_state_revision.fetch_add(1);
+    has_projection_ = false;
+  }
+  return view_revision_;
+}
+
+bool Context::SetPreeditProjection(PreeditProjection projection) {
+  if (input_.empty() || input_.size() > kMaxProjectionBytes ||
+      projection.text.size() > kMaxProjectionBytes ||
+      projection.input_revision != input_revision_ ||
+      projection.view_revision != view_revision() ||
+      projection.raw_to_display.size() != input_.size() + 1 ||
+      projection.raw_to_display.front() != 0 ||
+      projection.raw_to_display.back() != projection.text.size() ||
+      projection.sel_start > projection.sel_end ||
+      projection.sel_end > projection.text.size() ||
+      projection.text.find_first_of("\r\n\t") != string::npos)
+    return false;
+  vector<bool> raw_boundaries, display_boundaries;
+  if (!Utf8Boundaries(input_, &raw_boundaries) ||
+      !Utf8Boundaries(projection.text, &display_boundaries) ||
+      !raw_boundaries[caret_pos_] ||
+      !display_boundaries[projection.sel_start] ||
+      !display_boundaries[projection.sel_end])
+    return false;
+  size_t previous = 0;
+  for (size_t value : projection.raw_to_display) {
+    if (value < previous || value > projection.text.size() ||
+        !display_boundaries[value])
+      return false;
+    previous = value;
+  }
+  if (projection.regions.size() > 64)
+    return false;
+  size_t previous_end = 0;
+  for (const auto& region : projection.regions) {
+    if (region.start < previous_end || region.start >= region.end ||
+        region.end > projection.text.size() ||
+        !display_boundaries[region.start] || !display_boundaries[region.end] ||
+        region.style_key.size() > 64)
+      return false;
+    for (unsigned char ch : region.style_key)
+      if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+            (ch >= '0' && ch <= '9') || ch == '_' || ch == '.' || ch == '-'))
+        return false;
+    previous_end = region.end;
+  }
+  projection_ = std::move(projection);
+  has_projection_ = true;
+  return true;
+}
+
+an<Candidate> Context::MakeAtomicCandidate(an<Candidate> candidate) const {
+  if (!candidate || input_.empty() || input_.size() > kMaxProjectionBytes ||
+      get_property("_interaction_mode").empty() ||
+      interaction::HasAtomicCandidate(candidate) ||
+      !IsSynthesizedPayload(candidate))
+    return nullptr;
+  // Never silently discard a previously converted prefix. Atomic-mode Lua
+  // must own the complete input before generating this synthesized result.
+  for (size_t i = 0; i + 1 < composition_.size(); ++i)
+    if (composition_[i].status >= Segment::kSelected)
+      return nullptr;
+  return New<interaction::AtomicCandidate>(
+      std::move(candidate), instance_id_, input_revision_, input_,
+      get_property("_interaction_mode"));
+}
+
+bool Context::IsAtomicCandidateCurrent(const an<Candidate>& candidate) const {
+  auto atomic = interaction::AsAtomicCandidate(candidate);
+  return atomic && atomic->instance_id() == instance_id_ &&
+         atomic->input_revision() == input_revision_ &&
+         atomic->input() == input_ && !input_.empty() &&
+         !atomic->mode().empty() &&
+         atomic->mode() == get_property("_interaction_mode") &&
+         candidate->start() == 0 && candidate->end() == input_.size();
+}
+
+bool Context::PrepareAtomicSelection(an<Candidate> candidate, uint32_t item_id) {
+  if (!IsAtomicCandidateCurrent(candidate))
+    return false;
+  // OnSelect can call Commit after this same normalization. Keep that path
+  // idempotent, including _auto_commit=false's trailing empty segment.
+  if (composition_.size() <= 2 && !composition_.empty() &&
+      composition_.front().HasTag("atomic_result") &&
+      composition_.front().HasAlternate() &&
+      composition_.front().start == 0 &&
+      composition_.front().end == input_.size() &&
+      composition_.front().GetSelectedCandidate() == candidate &&
+      (composition_.size() == 1 ||
+       (composition_.back().start == input_.size() &&
+        composition_.back().end == input_.size() &&
+        !composition_.back().GetSelectedCandidate())))
+    return true;
+  for (size_t i = 0; i + 1 < composition_.size(); ++i)
+    if (composition_[i].status >= Segment::kSelected)
+      return false;
+  Composition replacement;
