+  int raw_input_revision(lua_State* L) {
+    const T& ctx = LuaType<T&>::todata(L, 1);
+    // The generic unsigned-long-long adapter inherits the 32-bit int adapter.
+    // Revisions need the Lua integer path directly to avoid truncating guards.
+    lua_pushinteger(L, static_cast<lua_Integer>(ctx.input_revision()));
+    return 1;
+  }
+
+  int raw_view_revision(lua_State* L) {
+    const T& ctx = LuaType<T&>::todata(L, 1);
+    lua_pushinteger(L, static_cast<lua_Integer>(ctx.view_revision()));
+    return 1;
+  }
+
+  bool read_unsigned_integer(lua_State* L, int index, uint64_t* value) {
+#if LUA_VERSION_NUM >= 503
+    if (!lua_isinteger(L, index))
+      return false;
+#else
+    // Older Lua versions have one numeric type.  Reject numeric strings,
+    // fractions and out-of-range values before invoking their integer cast.
+    if (lua_type(L, index) != LUA_TNUMBER)
+      return false;
+    const lua_Number number = lua_tonumber(L, index);
+    if (!std::isfinite(number) || number < 0 || std::trunc(number) != number ||
+        number >= std::ldexp(lua_Number{1},
+                             std::numeric_limits<lua_Integer>::digits))
+      return false;
+#endif
+    const lua_Integer integer = lua_tointeger(L, index);
+    if (integer < 0)
+      return false;
+    *value = static_cast<uint64_t>(integer);
+    return true;
+  }
+
+  void raw_projection_field(lua_State* L, int table, const char* key) {
+    lua_pushstring(L, key);
+    lua_rawget(L, table);
+  }
+
+  bool read_projection_integer(lua_State* L, const char* key, uint64_t* value) {
+    raw_projection_field(L, 2, key);
+    const bool valid = read_unsigned_integer(L, -1, value);
+    lua_pop(L, 1);
+    return valid;
+  }
+
+  bool read_projection_region(lua_State* L, int table, size_t text_size,
+                              size_t previous_end, PreeditDisplayRegion* region) {
+    uint64_t start = 0, end = 0;
+    raw_projection_field(L, table, "start");
+    const bool valid_start = read_unsigned_integer(L, -1, &start);
+    lua_pop(L, 1);
+    raw_projection_field(L, table, "end");
+    const bool valid_end = read_unsigned_integer(L, -1, &end);
+    lua_pop(L, 1);
+    if (!valid_start || !valid_end || start < previous_end || start >= end ||
+        end > text_size)
+      return false;
+    region->start = static_cast<size_t>(start);
+    region->end = static_cast<size_t>(end);
+
+    raw_projection_field(L, table, "style_key");
+    if (!lua_isnil(L, -1)) {
+      if (lua_type(L, -1) != LUA_TSTRING) {
+        lua_pop(L, 1);
+        return false;
+      }
+      size_t length = 0;
+      const char* bytes = lua_tolstring(L, -1, &length);
+      if (!CandidateReg::valid_style_key(bytes, length)) {
+        lua_pop(L, 1);
+        return false;
+      }
+      region->style_key.assign(bytes, length);
+    }
+    lua_pop(L, 1);
+
+    raw_projection_field(L, table, "highlightable");
+    if (!lua_isnil(L, -1)) {
+      if (lua_type(L, -1) != LUA_TBOOLEAN) {
+        lua_pop(L, 1);
+        return false;
+      }
+      region->highlightable = lua_toboolean(L, -1) != 0;
+    }
+    lua_pop(L, 1);
+    return true;
+  }
