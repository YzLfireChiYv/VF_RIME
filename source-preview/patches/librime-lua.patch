+  bool valid_style_key(const char* bytes, size_t length) {
+    if (length > 64)
+      return false;
+    for (size_t i = 0; i < length; ++i) {
+      const char ch = bytes[i];
+      if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+            (ch >= '0' && ch <= '9') || ch == '_' || ch == '.' || ch == '-'))
+        return false;
+    }
+    return true;
+  }
+
+  string lua_opt_style_key(lua_State* L, int table, bool* specified = nullptr) {
+    lua_getfield(L, table, "style_key");
+    const bool present = !lua_isnil(L, -1) && !lua_isnone(L, -1);
+    if (specified)
+      *specified = present;
+    string value;
+    if (present) {
+      if (lua_type(L, -1) != LUA_TSTRING)
+        luaL_error(L, "Interaction: style_key must be a string");
+      size_t length = 0;
+      const char* bytes = lua_tolstring(L, -1, &length);
+      if (length > 64)
+        luaL_error(L, "Interaction: style_key exceeds 64 bytes");
+      if (!valid_style_key(bytes, length))
+        luaL_error(L, "Interaction: style_key allows only ASCII letters, digits, _, . and -");
+      value.assign(bytes, length);
+    }
+    lua_pop(L, 1);
+    return value;
+  }
