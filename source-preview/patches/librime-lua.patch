+    bool label_explicit = false;
+    string comment;
+    bool comment_explicit = false;
+    string style_key;
+    bool style_explicit = false;
+    an<T> source_cand;
+    if (lua_istable(L, 2)) {
+      string specified = lua_opt_string(L, 2, "kind");
+      if (!specified.empty()) {
+        kind_explicit = true;
+        kind_name = specified;
+      }
+      lua_getfield(L, 2, "label");
+      if (!lua_isnil(L, -1) && !lua_isnone(L, -1)) {
+        label_explicit = true;
+        if (lua_isstring(L, -1))
+          label = lua_tostring(L, -1);
+      }
+      lua_pop(L, 1);
+      lua_getfield(L, 2, "comment");
+      if (!lua_isnil(L, -1) && !lua_isnone(L, -1)) {
+        comment_explicit = true;
+        if (lua_isstring(L, -1))
+          comment = lua_tostring(L, -1);
+      }
+      lua_pop(L, 1);
+      style_key = lua_opt_style_key(L, 2, &style_explicit);
+      source_cand = lua_opt_candidate(L, 2, "source");
+    }
+    an<interaction::InteractionCandidate> item =
+        interaction::AsInteraction(cand);
+    const bool existed = bool(item);
+    interaction::ItemKind kind = interaction::ItemKind::kSource;
+    if (existed && !kind_explicit)
+      kind = item->kind();
+    else if (kind_explicit)
+      kind = interaction::KindFromName(kind_name);
+    if (kind != interaction::ItemKind::kSource &&
+        kind != interaction::ItemKind::kAssociated)
+      return luaL_error(L, "Interaction.decorate: kind must be source or associated");
+    if (kind == interaction::ItemKind::kAssociated && !source_cand &&
+        !(item && item->source()))
+      return luaL_error(L, "Interaction.decorate: associated item needs source candidate");
+    if (existed) {
+      if (kind_explicit)
+        item->set_kind(kind);
+      if (label_explicit)
+        item->set_label(label);
+      if (comment_explicit)
+        item->set_display_comment(comment);
+    } else {
+      item = New<interaction::InteractionCandidate>(cand, kind, string(), comment);
+      if (label_explicit)
+        item->set_label(label);
+      if (comment_explicit)
