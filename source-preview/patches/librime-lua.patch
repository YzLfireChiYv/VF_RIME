+  int raw_set_preedit_projection(lua_State* L) {
+    T& ctx = LuaType<T&>::todata(L, 1);
+    constexpr size_t kMaxProjectionBytes = 64 * 1024;
+    // Parse into a local value first.  Malformed or stale projections leave
+    // the currently installed view untouched and return false to the caller.
+    auto rejected = [L]() {
+      lua_pushboolean(L, 0);
+      return 1;
+    };
+    if (!lua_istable(L, 2) || ctx.input().size() > kMaxProjectionBytes)
+      return rejected();
+
+    PreeditProjection projection;
+    uint64_t sel_start = 0;
+    uint64_t sel_end = 0;
+    if (!read_projection_integer(L, "input_revision", &projection.input_revision) ||
+        !read_projection_integer(L, "view_revision", &projection.view_revision) ||
+        !read_projection_integer(L, "sel_start", &sel_start) ||
+        !read_projection_integer(L, "sel_end", &sel_end) ||
+        sel_start > (std::numeric_limits<size_t>::max)() ||
+        sel_end > (std::numeric_limits<size_t>::max)())
+      return rejected();
+    projection.sel_start = static_cast<size_t>(sel_start);
+    projection.sel_end = static_cast<size_t>(sel_end);
+
+    raw_projection_field(L, 2, "text");
+    if (lua_type(L, -1) != LUA_TSTRING) {
+      lua_pop(L, 1);
+      return rejected();
+    }
+    size_t text_size = 0;
+    const char* text = lua_tolstring(L, -1, &text_size);
+    if (text_size > kMaxProjectionBytes || std::memchr(text, 0, text_size)) {
+      lua_pop(L, 1);
+      return rejected();
+    }
+    projection.text.assign(text, text_size);
+    lua_pop(L, 1);
+
+    raw_projection_field(L, 2, "raw_to_display");
+    if (!lua_istable(L, -1)) {
+      lua_pop(L, 1);
+      return rejected();
+    }
+    const size_t map_size = lua_rawlen(L, -1);
+    if (map_size > kMaxProjectionBytes + 1 ||
+        map_size != ctx.input().size() + 1) {
+      lua_pop(L, 1);
+      return rejected();
+    }
+    projection.raw_to_display.reserve(map_size);
+    const int map_table = lua_gettop(L);
+    for (size_t i = 0; i < map_size; ++i) {
+      lua_rawgeti(L, map_table, static_cast<lua_Integer>(i + 1));
+      uint64_t offset = 0;
+      const bool valid = read_unsigned_integer(L, -1, &offset) &&
+                         offset <= (std::numeric_limits<size_t>::max)() &&
+                         offset <= text_size;
+      lua_pop(L, 1);
+      if (!valid) {
+        lua_pop(L, 1);
+        return rejected();
+      }
+      projection.raw_to_display.push_back(static_cast<size_t>(offset));
+    }
+    lua_pop(L, 1);
+    raw_projection_field(L, 2, "regions");
+    if (!lua_isnil(L, -1)) {
+      if (!lua_istable(L, -1)) {
+        lua_pop(L, 1);
+        return rejected();
+      }
+      const int regions_table = lua_gettop(L);
+      const size_t count = lua_rawlen(L, regions_table);
+      if (count > 64) {
+        lua_pop(L, 1);
+        return rejected();
+      }
+      // A dense list only: sparse numeric keys or map fields must not silently
+      // disappear behind rawlen and turn a requested control span into body.
+      lua_pushnil(L);
+      while (lua_next(L, regions_table)) {
+        uint64_t index = 0;
+        const bool valid = read_unsigned_integer(L, -2, &index) &&
+                           index >= 1 && index <= count;
+        lua_pop(L, 1);
+        if (!valid) {
+          lua_pop(L, 2);  // Invalid key and regions table.
+          return rejected();
+        }
+      }
+      projection.regions.reserve(count);
+      size_t previous_end = 0;
+      for (size_t i = 0; i < count; ++i) {
+        lua_rawgeti(L, regions_table, static_cast<lua_Integer>(i + 1));
+        PreeditDisplayRegion region;
+        const bool valid = lua_istable(L, -1) &&
+            read_projection_region(L, lua_gettop(L), text_size,
+                                   previous_end, &region);
+        lua_pop(L, 1);
+        if (!valid) {
+          lua_pop(L, 1);
+          return rejected();
+        }
+        previous_end = region.end;
+        projection.regions.push_back(std::move(region));
+      }
+    }
+    lua_pop(L, 1);
+    // The core verifies UTF-8 boundaries, map ordering, endpoints and revisions.
+    lua_pushboolean(L, ctx.SetPreeditProjection(std::move(projection)));
+    return 1;
+  }
