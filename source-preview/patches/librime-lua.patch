+  int raw_attach(lua_State* L) {
+    an<T> cand = LuaType<an<T>>::todata(L, 1);
+    auto parent = interaction::AsInteraction(cand);
+    if (!parent)
+      return luaL_error(L, "Interaction.attach: parent must be a decorated candidate");
+    if (!lua_istable(L, 2))
+      return luaL_error(L, "Interaction.attach: rod item table expected");
+    lua_Integer n = luaL_len(L, 2);
+    for (lua_Integer i = 1; i <= n; ++i) {
+      lua_rawgeti(L, 2, i);
+      if (!lua_istable(L, -1)) {
+        lua_pop(L, 1);
+        return luaL_error(L, "Interaction.attach: rod item %d must be a table", (int)i);
+      }
+      int row = lua_gettop(L);
+      string kind_name = lua_opt_string(L, row, "kind");
+      auto kind = interaction::KindFromName(kind_name);
+      if (kind != interaction::ItemKind::kNotice &&
+          kind != interaction::ItemKind::kOutput) {
+        lua_pop(L, 1);
+        return luaL_error(L, "Interaction.attach: kind must be notice or output");
+      }
+      interaction::Attachment attachment;
+      attachment.kind = kind;
+      attachment.label = lua_opt_string(L, row, "label");
+      attachment.comment = lua_opt_string(L, row, "comment");
+      attachment.hint = lua_opt_string(L, row, "hint");
+      attachment.style_key = lua_opt_style_key(L, row);
+      attachment.payload = lua_opt_candidate(L, row, "candidate");
+      string text = lua_opt_string(L, row, "text");
+      if (!attachment.payload && kind == interaction::ItemKind::kOutput) {
+        if (text.empty())
+          text = attachment.label;
+        attachment.payload = New<SimpleCandidate>(
+            "interaction_output", parent->start(), parent->end(), text,
+            attachment.comment);
+      }
+      if (kind == interaction::ItemKind::kNotice && attachment.payload)
+        attachment.payload.reset();
+      if (!parent->Attach(std::move(attachment))) {
+        lua_pop(L, 1);
+        return luaL_error(L, "Interaction.attach: cannot hold output payload");
+      }
+      lua_pop(L, 1);
+    }
+    LuaType<an<T>>::pushdata(L, cand);
+    return 1;
+  }
