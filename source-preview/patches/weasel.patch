+void StandardLayout::PrepareCandidateRegionStyles(PDWR pDWR) {
+  _interactionGeometry.clear();
+  _interactionBackgrounds.clear();
+  _interactionFrameToken = 0;
+  if (IS_FULLSCREENLAYOUT(_style)) {
+    auto point = [&](const ComPtr<IDWriteTextFormat1>& format) {
+      return format ? (int)(format->GetFontSize() / pDWR->dpiScaleFontPoint) : 0;
+    };
+    _regionStyleSource.font_point = point(pDWR->pTextFormat);
+    _regionStyleSource.label_font_point = point(pDWR->pLabelTextFormat);
+    _regionStyleSource.comment_font_point = point(pDWR->pCommentTextFormat);
+  }
+  PrepareTextRegionStyles(pDWR);
+  auto reserve_effects = [&](const UIStyle& item_style) {
+    int x = 0, y = 0;
+    if (item_style.shadow_radius) {
+      x = abs(item_style.shadow_offset_x) + item_style.shadow_radius * 2;
+      y = abs(item_style.shadow_offset_y) + item_style.shadow_radius * 2;
+      if (item_style.shadow_offset_x || item_style.shadow_offset_y) {
+        x -= item_style.shadow_radius / 2;
+        y -= item_style.shadow_radius / 2;
+      }
+    }
+    offsetX = max(offsetX, x + item_style.border * 2);
+    offsetY = max(offsetY, y + item_style.border * 2);
+  };
+  reserve_effects(_mainBackgroundStyle->style);
+  reserve_effects(_preeditRegion.resolved->style);
+  reserve_effects(_auxiliaryRegion.resolved->style);
+  _candidateRegionStyles.clear();
+  const auto& frame = _context.interaction;
+  const bool has_frame = frame.protocol_version == kInteractionProtocolVersion &&
+                         frame.frame_token;
+  if (has_frame)
+    _interactionFrameToken = frame.frame_token;
+  for (int i = 0; i < candidates_count && i < MAX_CANDIDATES_COUNT; ++i) {
+    const InteractionItem* main = nullptr;
+    if (has_frame) {
+      for (const auto& item : frame.items) {
+        if (!item.reference_only && item.menu_index == i) {
+          main = &item;
+          break;
+        }
+      }
+    }
+    auto resolved = ResolveStyle(pDWR, L"candidate", main ? main->kind : 1,
+                                main ? main->style_key : L"", i + 1);
+    real_margin_x = max(real_margin_x, resolved->style.hilite_padding_x);
+    real_margin_y = max(real_margin_y, resolved->style.hilite_padding_y);
+    reserve_effects(resolved->style);
+    _candidateRegionStyles.push_back(resolved);
+  }
+  real_margin_x = max(real_margin_x, max(
+      _preeditRegion.resolved->style.hilite_padding_x,
+      _auxiliaryRegion.resolved->style.hilite_padding_x));
+  real_margin_y = max(real_margin_y, max(
+      _preeditRegion.resolved->style.hilite_padding_y,
+      _auxiliaryRegion.resolved->style.hilite_padding_y));
+}
+
+void StandardLayout::BuildCandidateRegionGeometry() {
+  const auto& frame = _context.interaction;
+  for (int i = 0; i < candidates_count && i < MAX_CANDIDATES_COUNT; ++i) {
+    const InteractionItem* main = nullptr;
+    if (_interactionFrameToken) {
+      for (const auto& item : frame.items) {
+        if (!item.reference_only && item.menu_index == i) {
+          main = &item;
+          break;
+        }
+      }
+    }
+    InteractionLayoutItem item;
+    item.item_id = main ? main->id : 0;
+    item.menu_index = i;
+    item.selectable = !main || main->kind == 1 || main->kind == 2 || main->kind == 4;
+    item.resolved = _candidateRegionStyles[i];
+    item.bounds = _candidateRects[i];
+    item.bounds.InflateRect(item.resolved->style.hilite_padding_x,
+                            item.resolved->style.hilite_padding_y);
+    item.label_rect = _candidateLabelRects[i];
+    item.text_rect = _candidateTextRects[i];
+    item.comment_rect = _candidateCommentRects[i];
+    item.label = GetLabelText(labels, i, item.resolved->style.label_text_format.c_str());
+    // Vertical layouts retain the actual menu projection chosen by Lua.
+    item.text = candidates[i].str;
+    item.comment = comments[i].str;
+    _interactionGeometry.push_back(std::move(item));
+  }
+}
