+static bool _LoadRegionStyleRules(RimeConfig* config, const std::string& path,
+                                  UIStyle& style, ColorFormat format) {
+  if (!RegionPathDeclared(config, path))
+    return false;
+  style.interaction_region_styles.clear();
+  RegionConfigIterator iterator;
+  if (!iterator.List(config, path)) {
+    LOG(WARNING) << "Region style " << path << ": expected a list; layer cleared";
+    return true;
+  }
+  if (rime_api->config_list_size(config, path.c_str()) > 128) {
+    LOG(WARNING) << "Region style " << path << ": more than 128 rules; layer cleared";
+    return true;
+  }
+  while (rime_api->config_next(&iterator.value)) {
+    RegionStyleRule rule;
+    std::string error;
+    const std::string rule_path(iterator.value.path ? iterator.value.path : path);
+    if (!ParseRegionRule(config, rule_path, format, &rule, &error)) {
+      LOG(WARNING) << "Region style " << rule_path << ": " << error
+                   << "; whole rule skipped";
+      continue;
+    }
+    style.interaction_region_styles.push_back(std::move(rule));
+  }
+  // Rule count alone does not bound an IPC style archive (font fallbacks can
+  // be long). Reject an oversized layer before it can crowd out a key reply.
+  std::wstringstream budget;
+  {
+    boost::archive::text_woarchive archive(budget);
+    archive << style.interaction_region_styles;
+  }
+  if (budget.str().size() > 8 * 1024) {
+    style.interaction_region_styles.clear();
+    LOG(WARNING) << "Region style " << path
+                 << ": archive exceeds 8192 UTF-16 units; layer cleared";
+  }
+  return true;
+}
+
+static ColorFormat _RegionColorFormat(RimeConfig* config,
+                                      const std::string& color) {
+  std::string format;
+  const std::string path = "preset_color_schemes/" + color + "/color_format";
+  if (RegionScalar(config, path.c_str(), &format)) {
+    if (format == "argb") return COLOR_ARGB;
+    if (format == "rgba") return COLOR_RGBA;
+  }
+  return COLOR_ABGR;
+}
+
+static ColorFormat _BaseRegionColorFormat(bool dark_mode) {
+  RimeConfig config{};
+  if (!rime_api->config_open("weasel", &config))
+    return COLOR_ABGR;
+  char selected[256] = {}, dark[256] = {};
+  rime_api->config_get_string(&config, "style/color_scheme", selected, 255);
+  if (dark_mode && rime_api->config_get_string(
+                       &config, "style/color_scheme_dark", dark, 255))
+    std::memcpy(selected, dark, sizeof(selected));
+  const auto format = _RegionColorFormat(&config, selected);
+  rime_api->config_close(&config);
+  return format;
+}
