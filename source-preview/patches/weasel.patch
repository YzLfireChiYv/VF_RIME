+      bHandled = true;
+      return HTCLIENT;
+    }
+  }
+  // Per-pixel alpha already passes these holes to the window underneath;
+  // avoid treating them as candidate targets even for explicit hit queries.
+  bHandled = true;
+  return HTTRANSPARENT;
