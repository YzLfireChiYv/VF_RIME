+bool StandardLayout::MeasurePreeditFragments(const Text& text, PDWR pDWR,
+                                             CSize* size) {
+  auto& region = _preeditRegion;
+  region.fragments.clear();
+  const auto& frame = _context.interaction;
+  if (frame.protocol_version != kInteractionProtocolVersion ||
+      !frame.frame_token || frame.preedit_text != text.str ||
+      frame.preedit_spans.empty() || !region.resolved)
+    return false;
+  auto boundary = [&](int offset) {
+    if (offset < 0 || offset > (int)text.str.size())
+      return false;
+    return offset == 0 || offset == (int)text.str.size() ||
+        !(text.str[offset - 1] >= 0xd800 && text.str[offset - 1] <= 0xdbff &&
+          text.str[offset] >= 0xdc00 && text.str[offset] <= 0xdfff);
+  };
+  if (!boundary(region.range.start) || !boundary(region.range.end))
+    return false;
+  int previous = 0;
+  bool changes_display = false;
+  struct Part {
+    int start, end;
+    bool highlightable;
+    std::shared_ptr<InteractionResolvedStyle> resolved;
+  };
+  std::vector<Part> parts;
+  for (const auto& span : frame.preedit_spans) {
+    if (span.start < previous || span.end < span.start ||
+        !boundary(span.start) || !boundary(span.end))
+      return false;
+    if (span.start > previous)
+      parts.push_back({previous, span.start, true, region.resolved});
+    auto found = _preeditSpanStyles.find(span.style_key);
+    auto resolved = found == _preeditSpanStyles.end() ? region.resolved : found->second;
+    if (resolved->style != region.resolved->style ||
+        (!span.highlightable && span.start < region.range.end &&
+         span.end > region.range.start))
+      changes_display = true;
+    if (span.end > span.start)
+      parts.push_back({span.start, span.end, span.highlightable, resolved});
+    previous = span.end;
+  }
+  if (!changes_display)
+    return false;
+  if (previous < (int)text.str.size())
+    parts.push_back({previous, (int)text.str.size(), true, region.resolved});
+
+  const bool vertical = _style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT;
+  int along = 0, cross = 0;
+  for (const auto& part : parts) {
+    std::vector<int> stops{part.start};
+    if (region.range.start > part.start && region.range.start < part.end)
+      stops.push_back(region.range.start);
+    if (region.range.end > region.range.start &&
+        region.range.end > part.start && region.range.end < part.end)
+      stops.push_back(region.range.end);
+    stops.push_back(part.end);
+    for (size_t i = 1; i < stops.size(); ++i) {
+      InteractionPreeditFragment fragment;
+      fragment.text = text.str.substr(stops[i - 1], stops[i] - stops[i - 1]);
+      fragment.highlighted = part.highlightable &&
+          stops[i - 1] >= region.range.start && stops[i] <= region.range.end &&
+          region.range.start < region.range.end;
+      fragment.resolved = part.resolved;
+      CSize measured;
+      GetTextSizeDW(fragment.text, fragment.text.size(),
+                    fragment.resolved->preedit_format, pDWR, &measured);
+      if (vertical) {
+        fragment.bounds.SetRect(0, along, measured.cx, along + measured.cy);
+        along += measured.cy;
+        cross = max(cross, measured.cx);
+      } else {
+        fragment.bounds.SetRect(along, 0, along + measured.cx, measured.cy);
+        along += measured.cx;
+        cross = max(cross, measured.cy);
+      }
+      // Preserve only the two original official selection-boundary gaps.
+      if (region.range.start < region.range.end &&
+          ((stops[i] == region.range.start && region.range.start > 0) ||
+           (stops[i] == region.range.end &&
+            region.range.end < (int)text.str.size())))
+        along += region.resolved->style.hilite_spacing;
+      region.fragments.push_back(std::move(fragment));
+    }
+  }
+  for (auto& fragment : region.fragments) {
+    if (vertical)
+      fragment.bounds.right = cross;
+    else
+      fragment.bounds.bottom = cross;
+  }
+  *size = vertical ? CSize(cross, along) : CSize(along, cross);
+  return !region.fragments.empty();
+}
