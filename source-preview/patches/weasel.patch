+bool WeaselPanel::_HasInteractionGeometry() const {
+  return m_layout &&
+         !m_layout->GetInteractionGeometry().empty() &&
+         (!m_layout->GetInteractionFrameToken() ||
+          (m_ctx.interaction.protocol_version == kInteractionProtocolVersion &&
+           m_ctx.interaction.frame_token == m_layout->GetInteractionFrameToken()));
+}
+
+bool WeaselPanel::_HasShapedBackground() const {
+  return _HasInteractionGeometry() && !m_istorepos &&
+         !m_layout->GetInteractionBackgrounds().empty();
+}
+
+bool WeaselPanel::GetInteractionLayout(InteractionLayoutReport* report) const {
+  if (!report)
+    return false;
+  *report = InteractionLayoutReport{};
+  // Export the same final rectangles used by hit testing. Reverse-painted
+  // legacy windows do not yet expose transformed interaction geometry.
+  if (!IsWindow() || !IsWindowVisible() || hide_candidates || m_istorepos ||
+      !_HasInteractionGeometry() || !m_layout->GetInteractionFrameToken() ||
+      m_layout->GetInteractionFrameToken() != m_ctx.interaction.frame_token)
+    return false;
+  report->frame_token = m_layout->GetInteractionFrameToken();
+  for (const auto& item : m_layout->GetInteractionGeometry()) {
+    if (!item.selectable || !item.item_id || item.bounds.IsRectEmpty())
+      continue;
+    if (report->rectangles.size() == kInteractionMaxItems) {
+      *report = InteractionLayoutReport{};
+      return false;
+    }
+    report->rectangles.push_back(InteractionLayoutRect{
+        item.item_id, item.bounds.left, item.bounds.top, item.bounds.right,
+        item.bounds.bottom});
+  }
+  return !report->rectangles.empty();
+}
+
+const InteractionLayoutItem* WeaselPanel::_InteractionAt(
+    const CPoint& point) const {
+  if (!_HasInteractionGeometry())
+    return nullptr;
+  for (const auto& item : m_layout->GetInteractionGeometry()) {
+    CRect bounds = item.bounds;
+    if (m_istorepos && item.menu_index >= 0 &&
+        item.menu_index < MAX_CANDIDATES_COUNT)
+      bounds.OffsetRect(0, m_offsetys[item.menu_index]);
+    if (bounds.PtInRect(point))
+      return &item;
+  }
+  return nullptr;
+}
+
+void WeaselPanel::_DrawInteractionBackground(CDCHandle& dc) {
+  const auto& backgrounds = m_layout->GetInteractionBackgrounds();
+  // Draw the stems first.  The ordinary bar overlaps their upper edge, so
+  // rounded stem corners cannot leave a transparent crack at the junction.
+  for (int stems = 1; stems >= 0; --stems) {
+    for (const auto& background : backgrounds) {
+      if (background.is_rod != (stems != 0))
+        continue;
+      const auto& paint_style = background.resolved ?
+          background.resolved->style : m_style;
+      const int color = background.resolved ? paint_style.back_color :
+          (background.is_rod ? m_style.interaction_rod_back_color : m_style.back_color);
+      _HighlightText(dc, background.bounds, color, paint_style.shadow_color,
+                     background.resolved ? paint_style.round_corner_ex :
+                         DPI_SCALE(m_style.round_corner_ex), BackType::BACKGROUND,
+                     IsToRoundStruct(), paint_style.border_color,
+                     background.resolved ? &paint_style : nullptr);
+    }
+  }
+}
+
+void WeaselPanel::_DrawCandidateMark(CDCHandle& dc, const CRect& rect,
+                                      bool back,
+                                      const InteractionResolvedStyle* resolved) {
+  const auto& paint_style = resolved ? resolved->style : m_style;
+  auto scale = [&](int value) { return resolved ? value : DPI_SCALE(value); };
+  if (!COLORNOTTRANSPARENT(paint_style.hilited_mark_color))
+    return;
+  if (back) {
+    if (!paint_style.mark_text.empty())
+      return;
+    int height = min(rect.Height() - scale(paint_style.hilite_padding_y) * 2,
+                     rect.Height() - scale(paint_style.round_corner) * 2);
+    int width = min(rect.Width() - scale(paint_style.hilite_padding_x) * 2,
+                    rect.Width() - scale(paint_style.round_corner) * 2);
+    width = min(width, static_cast<int>(rect.Width() * 0.618));
+    height = min(height, static_cast<int>(rect.Height() * 0.618));
+    if (bar_scale_ != 1.0f) {
+      width = static_cast<int>(width * bar_scale_);
+      height = static_cast<int>(height * bar_scale_);
+    }
+    Gdiplus::Graphics graphics(dc);
+    graphics.SetSmoothingMode(Gdiplus::SmoothingModeHighQuality);
+    Gdiplus::SolidBrush brush(
+        GDPCOLOR_FROM_COLORREF(paint_style.hilited_mark_color));
+    CRect marker;
+    if (paint_style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT) {
+      const int x = rect.left + (rect.Width() - width) / 2;
+      marker.SetRect(x, rect.top, x + width, rect.top + m_layout->mark_height);
+    } else {
+      const int y = rect.top + (rect.Height() - height) / 2;
+      marker.SetRect(rect.left, y, rect.left + m_layout->mark_width, y + height);
+    }
+    GraphicsRoundRectPath path(marker,
+        paint_style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT ?
+            marker.Height() / 2 : marker.Width() / 2);
+    graphics.FillPath(&brush, &path);
+    return;
+  }
+  if (paint_style.mark_text.empty())
+    return;
+  const int vgap = m_layout->mark_height ?
+      (rect.Height() - m_layout->mark_height) / 2 : 0;
+  const int hgap = m_layout->mark_width ?
+      (rect.Width() - m_layout->mark_width) / 2 : 0;
+  CRect marker;
+  if (paint_style.layout_type == UIStyle::LAYOUT_VERTICAL_TEXT)
+    marker.SetRect(rect.left + hgap,
+        rect.top + scale(paint_style.hilite_padding_y),
+        rect.left + hgap + m_layout->mark_width,
+        rect.top + scale(paint_style.hilite_padding_y) + m_layout->mark_height);
+  else
+    marker.SetRect(rect.left + scale(paint_style.hilite_padding_x),
+        rect.top + vgap,
+        rect.left + scale(paint_style.hilite_padding_x) + m_layout->mark_width,
+        rect.bottom - vgap);
+  _TextOut(marker, paint_style.mark_text, paint_style.mark_text.size(),
+           paint_style.hilited_mark_color, resolved ? resolved->mark_format.Get() :
+               pDWR->pTextFormat.Get());
+}
+
+bool WeaselPanel::_DrawInteractionCandidates(CDCHandle& dc, bool back) {
+  const auto& geometry = m_layout->GetInteractionGeometry();
+  const uint32_t active = m_ctx.interaction.active_item_id;
+  bool visible_active = false;
+  for (const auto& item : geometry) {
+    if (item.item_id && item.item_id == active && item.selectable) {
+      visible_active = true;
+      break;
+    }
+  }
+  for (const auto& original : geometry) {
+    auto item = original;
+    if (m_istorepos && item.menu_index >= 0 &&
+        item.menu_index < MAX_CANDIDATES_COUNT)
+      item.Offset(0, m_offsetys[item.menu_index]);
+    const auto& paint_style = item.resolved ? item.resolved->style : m_style;
+    const bool selected = item.selectable && (visible_active ?
+        item.item_id == active : !item.is_rod &&
+        item.menu_index == m_ctx.cinfo.highlighted);
+    const bool hovered = item.selectable && !selected &&
+        m_hoverInteractionFrame == m_layout->GetInteractionFrameToken() &&
+        (item.item_id ? item.item_id == m_hoverInteractionItem :
+                         !item.is_rod && item.menu_index == m_hoverIndex);
+    if (back) {
+      int background = paint_style.candidate_back_color;
+      int shadow = paint_style.candidate_shadow_color;
+      int border = paint_style.candidate_border_color;
+      if (selected || hovered) {
+        background = paint_style.hilited_candidate_back_color;
+        shadow = paint_style.hilited_candidate_shadow_color;
+        border = paint_style.hilited_candidate_border_color;
+        if (hovered) {
+          background = HALF_ALPHA_COLOR(background);
+          shadow = HALF_ALPHA_COLOR(shadow);
+          border = HALF_ALPHA_COLOR(border);
+        }
+      }
+      IsToRoundStruct round_info = item.is_rod ? IsToRoundStruct() :
+          m_layout->GetRoundInfo(item.menu_index);
+      if (m_istorepos && !item.is_rod)
+        ReconfigRoundInfo(round_info, item.menu_index, m_candidateCount);
+      _HighlightText(dc, item.bounds, background, shadow,
+                     item.resolved ? paint_style.round_corner :
+                         DPI_SCALE(paint_style.round_corner), BackType::CAND,
+                     round_info, border, item.resolved ? &paint_style : nullptr);
+      if (selected)
+        _DrawCandidateMark(dc, item.bounds, true, item.resolved.get());
+      continue;
+    }
+    const bool hilited = selected || hovered;
+    const int label_color = hilited ? paint_style.hilited_label_text_color :
+                                      paint_style.label_text_color;
+    const int text_color = hilited ? paint_style.hilited_candidate_text_color :
+                                     paint_style.candidate_text_color;
+    const int comment_color = hilited ? paint_style.hilited_comment_text_color :
+                                        paint_style.comment_text_color;
+    if (!item.label.empty() && !item.label_rect.IsRectEmpty())
+      _TextOut(item.label_rect, item.label, item.label.size(), label_color,
+               item.resolved ? item.resolved->label_format.Get() :
+                   pDWR->pLabelTextFormat.Get());
+    if (!item.text.empty() && !item.text_rect.IsRectEmpty())
+      _TextOut(item.text_rect, item.text, item.text.size(), text_color,
+               item.resolved ? item.resolved->text_format.Get() :
+                   pDWR->pTextFormat.Get());
+    if (!item.comment.empty() && !item.comment_rect.IsRectEmpty())
+      _TextOut(item.comment_rect, item.comment, item.comment.size(),
+               comment_color, item.resolved ? item.resolved->comment_format.Get() :
+                   pDWR->pCommentTextFormat.Get());
+    if (selected)
+      _DrawCandidateMark(dc, item.bounds, false, item.resolved.get());
+  }
+  return !geometry.empty();
+}
