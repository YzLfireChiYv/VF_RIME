+namespace weasel {
+namespace {
+
+// A process-local opaque namespace, followed by a global monotonic sequence.
+// Never wrap: exhaustion disables new frames instead of reusing a token.
+uint64_t InitialToken() {
+  uint64_t seed = static_cast<uint64_t>(
+      std::chrono::high_resolution_clock::now().time_since_epoch().count());
+  try {
+    std::random_device random;
+    seed ^= (static_cast<uint64_t>(random()) << 32) ^ random();
+  } catch (...) {
+    // Token opacity is not an authentication boundary. Uniqueness within this
+    // server process comes from the sequence, also on systems without entropy.
+  }
+  return (seed & 0x7fffffffffffffffull) | 1;
+}
+
+uint64_t NextToken() {
+  static std::atomic<uint64_t> sequence{InitialToken()};
+  uint64_t value = sequence.load(std::memory_order_relaxed);
+  while (value != (std::numeric_limits<uint64_t>::max)()) {
+    if (sequence.compare_exchange_weak(value, value + 1,
+                                       std::memory_order_relaxed))
+      return value;
+  }
+  return 0;
+}
+
+bool Compatible(const RimeInteractionApi* api) {
+  return api && RIME_STRUCT_HAS_MEMBER(*api, api->select_item) &&
+         api->api_version == RIME_INTERACTION_API_VERSION &&
+         api->get_snapshot && api->free_snapshot && api->snapshot_is_current &&
+         api->highlight_item && api->select_item;
+}
+
+// Strict, bounded UTF-8 -> UTF-16. Reject malformed/overlong sequences instead
+// of replacing them, and stop before growing beyond the display codec limit.
+bool DisplayText(const char* input, std::wstring* output,
+                 std::vector<int32_t>* byte_to_unit = nullptr) {
+  output->clear();
+  if (byte_to_unit)
+    byte_to_unit->assign(1, 0);
+  if (!input)
+    return true;
+  constexpr size_t kMaxBytes = kInteractionMaxFieldUnits * 4;
+  size_t at = 0;
+  while (at < kMaxBytes && input[at]) {
+    uint32_t cp = static_cast<unsigned char>(input[at++]);
+    unsigned more = 0;
+    uint32_t minimum = 0;
+    if (cp >= 0xc2 && cp <= 0xdf) {
+      cp &= 0x1f;
+      more = 1;
+      minimum = 0x80;
+    } else if (cp >= 0xe0 && cp <= 0xef) {
+      cp &= 0x0f;
+      more = 2;
+      minimum = 0x800;
+    } else if (cp >= 0xf0 && cp <= 0xf4) {
+      cp &= 7;
+      more = 3;
+      minimum = 0x10000;
+    } else if (cp >= 0x80) {
+      return false;
+    }
+    for (unsigned i = 0; i < more; ++i) {
+      if (at == kMaxBytes)
+        return false;
+      auto byte = static_cast<unsigned char>(input[at++]);
+      if ((byte & 0xc0) != 0x80)
+        return false;
+      cp = (cp << 6) | (byte & 0x3f);
+    }
+    if (cp < minimum || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff))
+      return false;
+    size_t units = cp >= 0x10000 ? 2 : 1;
+    if (output->size() > kInteractionMaxFieldUnits - units)
+      return false;
+    if (units == 2) {
+      cp -= 0x10000;
+      output->push_back(static_cast<wchar_t>(0xd800 + (cp >> 10)));
+      output->push_back(static_cast<wchar_t>(0xdc00 + (cp & 0x3ff)));
+    } else {
+      output->push_back(static_cast<wchar_t>(cp));
+    }
+    if (byte_to_unit) {
+      byte_to_unit->resize(at + 1, -1);
+      (*byte_to_unit)[at] = static_cast<int32_t>(output->size());
+    }
+  }
+  return at < kMaxBytes || input[at] == '\0';
+}
+
+struct SnapshotOwner {
+  const RimeInteractionApi* api;
+  RimeInteractionSnapshot* value;
+  ~SnapshotOwner() {
+    if (value)
+      api->free_snapshot(value);
+  }
+};
+
+bool ReadPreedit(const RimeInteractionApi* api, RimeSessionId session_id,
+                 InteractionFrame* frame) {
+  if (!RIME_STRUCT_HAS_MEMBER(*api, api->free_preedit) ||
+      !api->get_preedit || !api->free_preedit)
+    return true;
+  struct PreeditOwner {
+    const RimeInteractionApi* api;
+    RimeInteractionPreedit* value;
+    ~PreeditOwner() {
+      if (value)
+        api->free_preedit(value);
+    }
+  } preedit{api, api->get_preedit(session_id)};
+  if (!preedit.value)
+    return true;
+  const auto& native = *preedit.value;
+  if (!RIME_STRUCT_HAS_MEMBER(native, native.spans) || native.span_count < 0 ||
+      native.span_count > 192 || (native.span_count && !native.spans))
+    return false;
+  std::vector<int32_t> byte_to_unit;
+  if (!DisplayText(native.text, &frame->preedit_text, &byte_to_unit))
+    return false;
+  int previous_end = 0;
+  for (int i = 0; i < native.span_count; ++i) {
+    const auto& source = native.spans[i];
+    if (source.start < previous_end || source.end <= source.start ||
+        static_cast<size_t>(source.end) >= byte_to_unit.size() ||
+        byte_to_unit[source.start] < 0 || byte_to_unit[source.end] < 0 ||
+        (source.highlightable != False && source.highlightable != True))
+      return false;
+    InteractionTextSpan span;
+    span.start = byte_to_unit[source.start];
+    span.end = byte_to_unit[source.end];
+    span.highlightable = source.highlightable != False;
+    if (!DisplayText(source.style_key, &span.style_key))
+      return false;
+    frame->preedit_spans.push_back(std::move(span));
+    previous_end = source.end;
+  }
+  return true;
+}
+
+bool BuildFrame(const RimeInteractionApi* api,
+                const RimeInteractionSnapshot& snapshot,
+                const RimeMenu& menu,
+                InteractionFrame* frame) {
+  // Native snapshots can contain prepared candidates beyond this page. The
+  // display bound applies after paging; this scan bound also keeps malformed
+  // extension data from causing unbounded server work.
+  constexpr int kMaxNativeItems = 65536;
+  if (snapshot.data_size < static_cast<int>(sizeof(snapshot) - sizeof(int)) ||
+      snapshot.api_version != RIME_INTERACTION_API_VERSION ||
+      snapshot.generation == 0 || snapshot.item_count < 0 ||
+      snapshot.item_count > kMaxNativeItems ||
+      (snapshot.item_count && !snapshot.items) || menu.num_candidates < 0 ||
+      (menu.num_candidates && (menu.page_no < 0 || menu.page_size <= 0 ||
+                               menu.num_candidates > menu.page_size)))
+    return false;
+  const int64_t first = static_cast<int64_t>(menu.page_no) * menu.page_size;
+  const int64_t last = first + menu.num_candidates;
+  std::map<uint32_t, const RimeInteractionItem*> items;
+  std::set<uint32_t> visible;
+  std::set<uint32_t> included;
+  std::set<int> slots;
+  for (int i = 0; i < snapshot.item_count; ++i) {
+    const auto& item = snapshot.items[i];
+    if (!item.id || !items.emplace(item.id, &item).second)
+      return false;
+    if (item.menu_index >= first && item.menu_index < last) {
+      if (!slots.insert(item.menu_index).second)
+        return false;
+      visible.insert(item.id);
+      included.insert(item.id);
+    }
+  }
+  if (slots.size() != static_cast<size_t>(menu.num_candidates))
+    return false;
+  for (int i = 0; i < snapshot.item_count; ++i) {
+    const auto& item = snapshot.items[i];
+    if (item.menu_index == -1 && visible.count(item.attached_to_id))
+      included.insert(item.id);
+  }
+  // Include only source identities referenced by the visible page. A source on
+  // a different page becomes a non-interactive reference without its own rod.
+  std::vector<uint32_t> pending(included.begin(), included.end());
+  for (size_t i = 0; i < pending.size(); ++i) {
+    const auto& item = *items.at(pending[i]);
+    if (item.source_id) {
+      auto source = items.find(item.source_id);
+      if (source == items.end())
+        return false;
+      if (included.insert(item.source_id).second)
+        pending.push_back(item.source_id);
+    }
+    if (included.size() > kInteractionMaxItems)
+      return false;
+  }
+  frame->protocol_version = kInteractionProtocolVersion;
+  frame->generation = snapshot.generation;
+  // A temporary nonzero token lets the shared codec validate the whole frame.
+  frame->frame_token = 1;
+  for (int i = 0; i < snapshot.item_count; ++i) {
+    const auto& native = snapshot.items[i];
+    if (!included.count(native.id))
+      continue;
+    InteractionItem item;
+    item.id = native.id;
+    item.source_id = native.source_id;
+    item.kind = native.kind;
+    const char* style_key =
+        RIME_STRUCT_HAS_MEMBER(*api, api->get_item_style) && api->get_item_style
+            ? api->get_item_style(&snapshot, native.id)
+            : nullptr;
+    if (!DisplayText(native.label, &item.label) ||
+        !DisplayText(native.comment, &item.comment) ||
+        !DisplayText(native.hint, &item.hint) ||
+        !DisplayText(style_key, &item.style_key))
+      return false;
+    if (visible.count(native.id)) {
+      item.menu_index = static_cast<int32_t>(native.menu_index - first);
+      item.attached_to_id = native.attached_to_id;
+      item.rod_id = native.rod_id;
+      item.rod_index = native.rod_index;
+    } else if (native.menu_index == -1 &&
+               visible.count(native.attached_to_id)) {
+      item.attached_to_id = native.attached_to_id;
+      item.rod_id = native.rod_id;
+      item.rod_index = native.rod_index;
+    } else {
+      item.reference_only = true;
+    }
+    if (!item.reference_only && item.kind != kRimeInteractionKindNotice) {
+      if (native.id == snapshot.active_item_id)
+        frame->active_item_id = native.id;
+    }
+    frame->items.push_back(std::move(item));
+  }
+  if (!frame->active_item_id) {
+    for (const auto& item : frame->items) {
+      if (!item.reference_only && item.kind != kRimeInteractionKindNotice &&
+          item.menu_index == menu.highlighted_candidate_index) {
+        frame->active_item_id = item.id;
+        break;
+      }
+    }
+  }
+  if (!ReadPreedit(api, snapshot.session_id, frame))
+    return false;
+  std::wstring wire;
+  return EncodeInteractionFrame(*frame, &wire);
+}
+
+}  // namespace
+
+InteractionSession::InteractionSession(const RimeInteractionApi* api)
+    : api_(Compatible(api) ? api : nullptr) {}
+
+InteractionSession::~InteractionSession() {
+  Invalidate();
+}
+
+InteractionSession::InteractionSession(InteractionSession&& other) noexcept {
+  *this = std::move(other);
+}
+
+InteractionSession& InteractionSession::operator=(
+    InteractionSession&& other) noexcept {
+  if (this == &other)
+    return *this;
+  Invalidate();
+  api_ = other.api_;
+  snapshot_ = other.snapshot_;
+  session_id_ = other.session_id_;
+  page_no_ = other.page_no_;
+  page_size_ = other.page_size_;
+  page_count_ = other.page_count_;
+  layout_revision_ = other.layout_revision_;
+  layout_has_rectangles_ = other.layout_has_rectangles_;
+  frame_ = std::move(other.frame_);
+  other.snapshot_ = nullptr;
+  other.session_id_ = 0;
+  other.Invalidate();
+  return *this;
+}
+
+void InteractionSession::Invalidate() {
+  if (session_id_ && api_ &&
+      RIME_STRUCT_HAS_MEMBER(*api_, api_->clear_layout) &&
+      api_->clear_layout)
+    api_->clear_layout(session_id_);
+  if (snapshot_)
+    api_->free_snapshot(snapshot_);
+  snapshot_ = nullptr;
+  session_id_ = 0;
+  page_no_ = -1;
+  page_size_ = 0;
+  page_count_ = 0;
+  layout_revision_ = 0;
+  layout_has_rectangles_ = false;
+  frame_.clear();
+}
+
+bool InteractionSession::Refresh(RimeSessionId session_id, const RimeMenu& menu) {
+  if (!api_ || !session_id) {
+    Invalidate();
+    return false;
+  }
+  SnapshotOwner fresh{api_, api_->get_snapshot(session_id)};
+  InteractionFrame next;
+  if (!fresh.value || fresh.value->session_id != session_id ||
+      !BuildFrame(api_, *fresh.value, menu, &next) ||
+      !api_->snapshot_is_current(session_id, fresh.value)) {
+    Invalidate();
+    return false;
+  }
+  bool same_content = snapshot_ && session_id_ == session_id &&
+                      api_->snapshot_is_current(session_id, snapshot_) &&
+                      frame_.generation == next.generation &&
+                      page_no_ == menu.page_no && page_size_ == menu.page_size &&
+                      page_count_ == menu.num_candidates &&
+                      frame_.items == next.items &&
+                      frame_.preedit_text == next.preedit_text &&
+                      frame_.preedit_spans == next.preedit_spans;
+  next.frame_token = same_content ? frame_.frame_token : NextToken();
+  if (!next.frame_token) {
+    Invalidate();
+    return false;
+  }
+  if (!same_content) {
+    Invalidate();
+  } else {
+    // Highlight-only refreshes retain the final client geometry. Retiring a
+    // snapshot allocation must not clear a still-current frame's layout.
+    api_->free_snapshot(snapshot_);
+    snapshot_ = nullptr;
+  }
+  snapshot_ = fresh.value;
+  fresh.value = nullptr;
+  session_id_ = session_id;
+  page_no_ = menu.page_no;
+  page_size_ = menu.page_size;
+  page_count_ = menu.num_candidates;
+  frame_ = std::move(next);
+  return true;
+}
+
+bool InteractionSession::CanActivate(uint64_t token, uint32_t item_id) {
+  if (!snapshot_ || !token || token != frame_.frame_token || !item_id)
+    return false;
+  bool visible_output = false;
+  for (const auto& item : frame_.items) {
+    if (item.id == item_id) {
+      visible_output = !item.reference_only &&
+                       item.kind != kRimeInteractionKindNotice;
+      break;
+    }
+  }
+  if (!visible_output)
+    return false;
+  if (!api_->snapshot_is_current(session_id_, snapshot_)) {
+    Invalidate();
+    return false;
+  }
+  return true;
+}
+
+bool InteractionSession::Highlight(uint64_t token, uint32_t item_id) {
+  if (!CanActivate(token, item_id))
+    return false;
+  if (api_->highlight_item(session_id_, snapshot_, item_id) !=
+      kRimeInteractionOk) {
+    Invalidate();
+    return false;
+  }
+  frame_.active_item_id = item_id;
+  return true;
+}
+
+bool InteractionSession::Select(uint64_t token, uint32_t item_id) {
+  if (!CanActivate(token, item_id))
+    return false;
+  bool ok = api_->select_item(session_id_, snapshot_, item_id) ==
+            kRimeInteractionOk;
+  Invalidate();
+  return ok;
+}
+
+bool InteractionSession::ReportLayout(const InteractionLayoutReport& report) {
+  if (!snapshot_ || !report.frame_token ||
+      report.frame_token != frame_.frame_token || !report.layout_revision ||
+      report.layout_revision <= layout_revision_ ||
+      report.rectangles.size() > kInteractionMaxItems ||
+      !api_ || !RIME_STRUCT_HAS_MEMBER(*api_, api_->set_layout) ||
+      !api_->set_layout)
+    return false;
+  if (!api_->snapshot_is_current(session_id_, snapshot_)) {
+    Invalidate();
+    return false;
+  }
+  std::set<uint32_t> visible;
+  for (const auto& item : frame_.items) {
+    if (!item.reference_only && item.kind != kRimeInteractionKindNotice)
+      visible.insert(item.id);
+  }
+  std::set<uint32_t> reported;
+  std::vector<RimeInteractionRect> rectangles;
+  rectangles.reserve(report.rectangles.size());
+  for (const auto& rect : report.rectangles) {
+    if (!visible.count(rect.item_id) ||
+        !reported.insert(rect.item_id).second || rect.left >= rect.right ||
+        rect.top >= rect.bottom)
+      return false;
+    rectangles.push_back(RimeInteractionRect{
+        rect.item_id, rect.left, rect.top, rect.right, rect.bottom});
+  }
+  const int status = api_->set_layout(
+      session_id_, snapshot_, report.frame_token, report.layout_revision,
+      rectangles.empty() ? nullptr : rectangles.data(),
+      static_cast<int>(rectangles.size()));
+  if (status != kRimeInteractionOk) {
+    if (status == kRimeInteractionExpired)
+      Invalidate();
+    return false;
+  }
+  layout_revision_ = report.layout_revision;
+  layout_has_rectangles_ = !report.rectangles.empty();
+  return true;
+}
+
+}  // namespace weasel
