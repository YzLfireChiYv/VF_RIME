+namespace weasel {
+
+inline UIStyle ResolveRegionStyle(const UIStyle& base,
+                                  const std::wstring& region,
+                                  int kind = 0,
+                                  const std::wstring& style_key = L"",
+                                  int column = 0,
+                                  int row = 0,
+                                  const UIStyle* inherited_base = nullptr) {
+  UIStyle resolved = inherited_base ? *inherited_base : base;
+  resolved.interaction_region_styles.clear();
+  if (region == L"rod_background")
+    resolved.back_color = base.interaction_rod_back_color;
+  for (const auto& rule : base.interaction_region_styles) {
+    if ((rule.region != L"*" && rule.region != region) ||
+        (rule.kind && rule.kind != kind) ||
+        (!rule.style_key.empty() && rule.style_key != style_key) ||
+        (rule.column && rule.column != column) ||
+        (rule.row && rule.row != row))
+      continue;
+    for (const auto& entry : rule.integers) {
+#define WEASEL_REGION_WIDE_(value) L##value
+#define WEASEL_REGION_WIDE(value) WEASEL_REGION_WIDE_(value)
+#define WEASEL_REGION_INTEGER(field) \
+      if (entry.first == WEASEL_REGION_WIDE(#field)) { \
+        resolved.field = entry.second; continue; \
+      }
+      WEASEL_REGION_INTEGER(font_point)
+      WEASEL_REGION_INTEGER(label_font_point)
+      WEASEL_REGION_INTEGER(comment_font_point)
+      WEASEL_REGION_INTEGER(baseline)
+      WEASEL_REGION_INTEGER(linespacing)
+      WEASEL_REGION_INTEGER(spacing)
+      WEASEL_REGION_INTEGER(candidate_spacing)
+      WEASEL_REGION_INTEGER(hilite_spacing)
+      WEASEL_REGION_INTEGER(hilite_padding_x)
+      WEASEL_REGION_INTEGER(hilite_padding_y)
+      WEASEL_REGION_INTEGER(round_corner)
+      WEASEL_REGION_INTEGER(round_corner_ex)
+      WEASEL_REGION_INTEGER(border)
+      WEASEL_REGION_INTEGER(shadow_radius)
+      WEASEL_REGION_INTEGER(shadow_offset_x)
+      WEASEL_REGION_INTEGER(shadow_offset_y)
+      WEASEL_REGION_INTEGER(text_color)
+      WEASEL_REGION_INTEGER(candidate_text_color)
+      WEASEL_REGION_INTEGER(candidate_back_color)
+      WEASEL_REGION_INTEGER(candidate_shadow_color)
+      WEASEL_REGION_INTEGER(candidate_border_color)
+      WEASEL_REGION_INTEGER(label_text_color)
+      WEASEL_REGION_INTEGER(comment_text_color)
+      WEASEL_REGION_INTEGER(back_color)
+      WEASEL_REGION_INTEGER(interaction_rod_back_color)
+      WEASEL_REGION_INTEGER(shadow_color)
+      WEASEL_REGION_INTEGER(border_color)
+      WEASEL_REGION_INTEGER(hilited_text_color)
+      WEASEL_REGION_INTEGER(hilited_back_color)
+      WEASEL_REGION_INTEGER(hilited_shadow_color)
+      WEASEL_REGION_INTEGER(hilited_candidate_text_color)
+      WEASEL_REGION_INTEGER(hilited_candidate_back_color)
+      WEASEL_REGION_INTEGER(hilited_candidate_shadow_color)
+      WEASEL_REGION_INTEGER(hilited_candidate_border_color)
+      WEASEL_REGION_INTEGER(hilited_label_text_color)
+      WEASEL_REGION_INTEGER(hilited_comment_text_color)
+      WEASEL_REGION_INTEGER(hilited_mark_color)
+      WEASEL_REGION_INTEGER(prevpage_color)
+      WEASEL_REGION_INTEGER(nextpage_color)
+#undef WEASEL_REGION_INTEGER
+#undef WEASEL_REGION_WIDE
+#undef WEASEL_REGION_WIDE_
+      if (entry.first == L"align_type")
+        resolved.align_type = static_cast<UIStyle::LayoutAlignType>(entry.second);
+    }
+    for (const auto& entry : rule.strings) {
+      if (entry.first == L"font_face")
+        resolved.font_face = entry.second;
+      else if (entry.first == L"label_font_face")
+        resolved.label_font_face = entry.second;
+      else if (entry.first == L"comment_font_face")
+        resolved.comment_font_face = entry.second;
+    }
+  }
+  return resolved;
+}
