+#include <WeaselInteraction.h>
+
+#include <limits>
+#include <map>
+#include <set>
+#include <utility>
+
+namespace weasel {
+namespace {
+
+static_assert(sizeof(wchar_t) == 2, "Weasel interaction wire strings use UTF-16");
+static_assert(sizeof(uint32_t) == 4 && sizeof(uint64_t) == 8,
+              "Interaction integers require fixed widths");
+
+bool ValidText(const std::wstring& text) {
+  if (text.size() > kInteractionMaxFieldUnits)
+    return false;
+  for (size_t i = 0; i < text.size(); ++i) {
+    uint16_t unit = static_cast<uint16_t>(text[i]);
+    if (unit >= 0xd800 && unit <= 0xdbff) {
+      if (++i == text.size())
+        return false;
+      uint16_t low = static_cast<uint16_t>(text[i]);
+      if (low < 0xdc00 || low > 0xdfff)
+        return false;
+    } else if (unit >= 0xdc00 && unit <= 0xdfff) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ValidFrame(const InteractionFrame& frame) {
+  if (frame.protocol_version != kInteractionProtocolVersion ||
+      frame.frame_token == 0 || frame.generation == 0 ||
+      (frame.items.empty() && frame.preedit_text.empty()) ||
+      frame.items.size() > kInteractionMaxItems ||
+      !ValidText(frame.preedit_text) || frame.preedit_spans.size() > 192)
+    return false;
+  int32_t previous_end = 0;
+  auto boundary = [&frame](int32_t position) {
+    if (position < 0 || static_cast<size_t>(position) > frame.preedit_text.size())
+      return false;
+    if (position == 0 || static_cast<size_t>(position) == frame.preedit_text.size())
+      return true;
+    const uint16_t unit = static_cast<uint16_t>(frame.preedit_text[position]);
+    return unit < 0xdc00 || unit > 0xdfff;
+  };
+  for (const auto& span : frame.preedit_spans) {
+    if (span.start < previous_end || span.end <= span.start ||
+        !boundary(span.start) || !boundary(span.end) ||
+        !ValidText(span.style_key))
+      return false;
+    previous_end = span.end;
+  }
+  std::map<uint32_t, const InteractionItem*> ids;
+  for (const auto& item : frame.items) {
+    if (item.id == 0 || !ids.emplace(item.id, &item).second || item.kind < 1 ||
+        item.kind > 4 || item.menu_index < -1 || item.rod_index < -1 ||
+        !ValidText(item.label) || !ValidText(item.comment) ||
+        !ValidText(item.hint) || !ValidText(item.style_key))
+      return false;
+  }
+  auto known = [&ids](uint32_t id) { return id == 0 || ids.count(id) != 0; };
+  if (!known(frame.active_item_id))
+    return false;
+  if (frame.active_item_id != 0) {
+    const auto& active = *ids.at(frame.active_item_id);
+    if (active.reference_only || active.kind == 3)
+      return false;
+  }
+  std::set<int32_t> main_slots;
+  std::set<std::pair<uint32_t, int32_t>> row_slots;
+  for (const auto& item : frame.items) {
+    if (!known(item.source_id) || !known(item.attached_to_id) ||
+        !known(item.rod_id))
+      return false;
+    if (item.reference_only) {
+      if (item.menu_index != -1 || item.rod_id != 0 || item.attached_to_id != 0)
+        return false;
+    } else if (item.menu_index >= 0) {
+      if (item.rod_id != 0 || item.attached_to_id != 0 ||
+          !main_slots.insert(item.menu_index).second)
+        return false;
+    } else {
+      if (item.rod_id == 0 || item.attached_to_id != item.rod_id ||
+          item.rod_index < 0 || (item.kind != 3 && item.kind != 4))
+        return false;
+      const auto& parent = *ids.at(item.attached_to_id);
+      if (parent.reference_only || parent.menu_index < 0 ||
+          !row_slots.emplace(item.rod_id, item.rod_index).second)
+        return false;
+    }
+  }
+  return true;
+}
+
+class Writer {
+ public:
+  explicit Writer(std::wstring* output) : output_(output) { *output_ = L"WI3:"; }
+  bool Integer(uint64_t value, size_t bytes) {
+    constexpr wchar_t hex[] = L"0123456789ABCDEF";
+    if (bytes > (kInteractionMaxWireChars - output_->size()) / 2)
+      return false;
+    for (size_t i = 0; i < bytes; ++i) {
+      auto byte = static_cast<unsigned>(value & 0xff);
+      output_->push_back(hex[byte >> 4]);
+      output_->push_back(hex[byte & 15]);
+      value >>= 8;
+    }
+    return true;
+  }
+  bool Text(const std::wstring& text) {
+    if (!Integer(text.size(), 4))
+      return false;
+    for (wchar_t unit : text) {
+      if (!Integer(static_cast<uint16_t>(unit), 2))
+        return false;
+    }
+    return true;
+  }
+
+ private:
+  std::wstring* output_;
+};
+
+class Reader {
+ public:
+  explicit Reader(const std::wstring& input) : input_(input) {}
+  bool Integer(uint64_t* value, size_t bytes) {
+    if (bytes > (input_.size() - at_) / 2)
+      return false;
+    *value = 0;
+    for (size_t i = 0; i < bytes; ++i) {
+      int hi = Hex(input_[at_++]);
+      int lo = Hex(input_[at_++]);
+      if (hi < 0 || lo < 0)
+        return false;
+      *value |= static_cast<uint64_t>((hi << 4) | lo) << (8 * i);
+    }
+    return true;
+  }
+  bool U32(uint32_t* value) {
+    uint64_t raw;
+    if (!Integer(&raw, 4))
+      return false;
+    *value = static_cast<uint32_t>(raw);
+    return true;
+  }
+  bool I32(int32_t* value) {
+    uint32_t raw;
+    if (!U32(&raw))
+      return false;
+    // Avoid implementation-defined conversion of values above INT32_MAX.
+    *value = raw <= static_cast<uint32_t>((std::numeric_limits<int32_t>::max)())
+                 ? static_cast<int32_t>(raw)
+                 : -1 - static_cast<int32_t>(~raw);
+    return true;
+  }
+  bool Text(std::wstring* value) {
+    uint32_t units;
+    if (!U32(&units) || units > kInteractionMaxFieldUnits ||
+        units > (input_.size() - at_) / 4)
+      return false;
+    value->clear();
+    value->reserve(units);
+    for (uint32_t i = 0; i < units; ++i) {
+      uint64_t unit;
+      if (!Integer(&unit, 2))
+        return false;
+      value->push_back(static_cast<wchar_t>(unit));
+    }
+    return true;
+  }
+  bool done() const { return at_ == input_.size(); }
+
+ private:
+  static int Hex(wchar_t c) {
+    if (c >= L'0' && c <= L'9')
+      return c - L'0';
+    if (c >= L'A' && c <= L'F')
+      return c - L'A' + 10;
+    return -1;
+  }
+  const std::wstring& input_;
+  size_t at_ = 4;
+};
+
+}  // namespace
+
+bool EncodeInteractionFrame(const InteractionFrame& frame, std::wstring* wire) {
+  if (!wire)
+    return false;
+  wire->clear();
+  if (!ValidFrame(frame))
+    return false;
+  std::wstring result;
+  Writer writer(&result);
+  bool ok = writer.Integer(frame.protocol_version, 4) &&
+            writer.Integer(frame.frame_token, 8) &&
+            writer.Integer(frame.generation, 4) &&
+            writer.Integer(frame.active_item_id, 4) &&
+            writer.Integer(frame.items.size(), 4);
+  for (const auto& item : frame.items) {
+    if (!ok)
+      break;
+    ok = writer.Integer(item.id, 4) && writer.Integer(item.source_id, 4) &&
+         writer.Integer(item.attached_to_id, 4) && writer.Integer(item.rod_id, 4) &&
+         writer.Integer(static_cast<uint32_t>(item.kind), 4) &&
+         writer.Integer(static_cast<uint32_t>(item.menu_index), 4) &&
+         writer.Integer(static_cast<uint32_t>(item.rod_index), 4) &&
+         writer.Integer(item.reference_only ? 1 : 0, 4) &&
+         writer.Text(item.label) && writer.Text(item.comment) &&
+         writer.Text(item.hint) && writer.Text(item.style_key);
+  }
+  ok = ok && writer.Text(frame.preedit_text) &&
+       writer.Integer(frame.preedit_spans.size(), 4);
+  for (const auto& span : frame.preedit_spans) {
+    if (!ok)
+      break;
+    ok = writer.Integer(static_cast<uint32_t>(span.start), 4) &&
+         writer.Integer(static_cast<uint32_t>(span.end), 4) &&
+         writer.Text(span.style_key) &&
+         writer.Integer(span.highlightable ? 1 : 0, 4);
+  }
+  if (!ok)
+    return false;
+  wire->swap(result);
+  return true;
+}
+
+bool DecodeInteractionFrame(const std::wstring& wire, InteractionFrame* frame) {
+  if (!frame)
+    return false;
+  frame->clear();
+  if (wire.size() < 4 || wire.size() > kInteractionMaxWireChars ||
+      wire.compare(0, 4, L"WI3:") != 0 || (wire.size() - 4) % 2 != 0)
+    return false;
+  Reader reader(wire);
+  InteractionFrame parsed;
+  uint32_t count;
+  if (!reader.U32(&parsed.protocol_version) ||
+      !reader.Integer(&parsed.frame_token, 8) ||
+      !reader.U32(&parsed.generation) || !reader.U32(&parsed.active_item_id) ||
+      !reader.U32(&count) || count > kInteractionMaxItems)
+    return false;
+  parsed.items.reserve(count);
+  for (uint32_t i = 0; i < count; ++i) {
+    InteractionItem item;
+    uint32_t flags;
+    if (!reader.U32(&item.id) || !reader.U32(&item.source_id) ||
+        !reader.U32(&item.attached_to_id) || !reader.U32(&item.rod_id) ||
+        !reader.I32(&item.kind) || !reader.I32(&item.menu_index) ||
+        !reader.I32(&item.rod_index) || !reader.U32(&flags) || flags > 1 ||
+        !reader.Text(&item.label) || !reader.Text(&item.comment) ||
+        !reader.Text(&item.hint) || !reader.Text(&item.style_key))
+      return false;
+    item.reference_only = flags != 0;
+    parsed.items.push_back(std::move(item));
+  }
+  uint32_t span_count = 0;
+  if (!reader.Text(&parsed.preedit_text) || !reader.U32(&span_count) ||
+      span_count > 192)
+    return false;
+  parsed.preedit_spans.reserve(span_count);
+  for (uint32_t i = 0; i < span_count; ++i) {
+    InteractionTextSpan span;
+    uint32_t highlightable = 0;
+    if (!reader.I32(&span.start) || !reader.I32(&span.end) ||
+        !reader.Text(&span.style_key) || !reader.U32(&highlightable) ||
+        highlightable > 1)
+      return false;
+    span.highlightable = highlightable != 0;
+    parsed.preedit_spans.push_back(std::move(span));
+  }
+  if (!reader.done() || !ValidFrame(parsed))
+    return false;
+  *frame = std::move(parsed);
+  return true;
+}
+
+bool EncodeInteractionAction(const InteractionAction& action,
+                             std::vector<char>* bytes) {
+  if (!bytes)
+    return false;
+  bytes->clear();
+  if (!action.frame_token || !action.item_id ||
+      (action.action != InteractionActionType::Highlight &&
+       action.action != InteractionActionType::Select))
+    return false;
+  uint32_t words[] = {kInteractionProtocolVersion,
+                      static_cast<uint32_t>(action.action),
+                      static_cast<uint32_t>(action.frame_token),
+                      static_cast<uint32_t>(action.frame_token >> 32),
+                      action.item_id, 0};
+  for (uint32_t word : words) {
+    for (int shift = 0; shift < 32; shift += 8)
+      bytes->push_back(static_cast<char>((word >> shift) & 0xff));
+  }
+  return true;
+}
+
+bool DecodeInteractionAction(const std::vector<char>& bytes,
+                             InteractionAction* action) {
+  if (!action)
+    return false;
+  *action = InteractionAction{};
+  if (bytes.size() != kInteractionActionBytes)
+    return false;
+  uint32_t words[6] = {};
+  for (size_t i = 0; i < bytes.size(); ++i)
+    words[i / 4] |= static_cast<uint32_t>(static_cast<unsigned char>(bytes[i]))
+                    << (8 * (i % 4));
+  if (words[0] != kInteractionProtocolVersion || words[5] != 0 || !words[4] ||
+      (words[1] != static_cast<uint32_t>(InteractionActionType::Highlight) &&
+       words[1] != static_cast<uint32_t>(InteractionActionType::Select)))
+    return false;
+  action->frame_token = (static_cast<uint64_t>(words[3]) << 32) | words[2];
+  if (!action->frame_token)
+    return false;
+  action->item_id = words[4];
+  action->action = static_cast<InteractionActionType>(words[1]);
+  return true;
+}
+
+bool EncodeInteractionLayout(const InteractionLayoutReport& report,
+                              std::vector<char>* bytes) {
+  if (!bytes)
+    return false;
+  bytes->clear();
+  if (!report.frame_token || !report.layout_revision ||
+      report.rectangles.size() > kInteractionMaxItems)
+    return false;
+  std::set<uint32_t> ids;
+  for (const auto& rect : report.rectangles) {
+    if (!rect.item_id || !ids.insert(rect.item_id).second ||
+        rect.left >= rect.right || rect.top >= rect.bottom)
+      return false;
+  }
+  // Fixed little-endian values, independently versioned from action packets.
+  // Empty rectangles clear the layout belonging to this exact frame.
+  auto append = [&](uint64_t value, size_t width) {
+    for (size_t i = 0; i < width; ++i) {
+      bytes->push_back(static_cast<char>(value & 0xff));
+      value >>= 8;
+    }
+  };
+  append(kInteractionProtocolVersion, 4);
+  append(report.rectangles.size(), 4);
+  append(report.frame_token, 8);
+  append(report.layout_revision, 8);
+  for (const auto& rect : report.rectangles) {
+    append(rect.item_id, 4);
+    append(static_cast<uint32_t>(rect.left), 4);
+    append(static_cast<uint32_t>(rect.top), 4);
+    append(static_cast<uint32_t>(rect.right), 4);
+    append(static_cast<uint32_t>(rect.bottom), 4);
+  }
+  return true;
+}
+
+bool DecodeInteractionLayout(const std::vector<char>& bytes,
+                              InteractionLayoutReport* report) {
+  if (!report)
+    return false;
+  *report = InteractionLayoutReport{};
+  constexpr size_t kHeaderBytes = 24;
+  constexpr size_t kRectBytes = 20;
+  if (bytes.size() < kHeaderBytes ||
+      bytes.size() > kHeaderBytes + kInteractionMaxItems * kRectBytes)
+    return false;
+  size_t at = 0;
+  auto read = [&](size_t width) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < width; ++i)
+      value |= static_cast<uint64_t>(static_cast<unsigned char>(bytes[at++]))
+               << (8 * i);
+    return value;
+  };
+  if (read(4) != kInteractionProtocolVersion)
+    return false;
+  const uint32_t count = static_cast<uint32_t>(read(4));
+  if (count > kInteractionMaxItems ||
+      bytes.size() != kHeaderBytes + count * kRectBytes)
+    return false;
+  InteractionLayoutReport parsed;
+  parsed.frame_token = read(8);
+  parsed.layout_revision = read(8);
+  if (!parsed.frame_token || !parsed.layout_revision)
+    return false;
+  auto signed32 = [](uint64_t value) {
+    uint32_t raw = static_cast<uint32_t>(value);
+    return raw <= static_cast<uint32_t>((std::numeric_limits<int32_t>::max)())
+               ? static_cast<int32_t>(raw)
+               : -1 - static_cast<int32_t>(~raw);
+  };
+  std::set<uint32_t> ids;
+  parsed.rectangles.reserve(count);
+  for (uint32_t i = 0; i < count; ++i) {
+    InteractionLayoutRect rect;
+    rect.item_id = static_cast<uint32_t>(read(4));
+    rect.left = signed32(read(4));
+    rect.top = signed32(read(4));
+    rect.right = signed32(read(4));
+    rect.bottom = signed32(read(4));
+    if (!rect.item_id || !ids.insert(rect.item_id).second ||
+        rect.left >= rect.right || rect.top >= rect.bottom)
+      return false;
+    parsed.rectangles.push_back(rect);
+  }
+  *report = std::move(parsed);
+  return true;
+}
