+struct RegionConfigIterator {
+  RimeConfigIterator value{};
+  bool active = false;
+  ~RegionConfigIterator() {
+    if (active)
+      rime_api->config_end(&value);
+  }
+  bool Map(RimeConfig* config, const std::string& path) {
+    return active = !!rime_api->config_begin_map(&value, config, path.c_str());
+  }
+  bool List(RimeConfig* config, const std::string& path) {
+    return active = !!rime_api->config_begin_list(&value, config, path.c_str());
+  }
+};
+
+bool RegionPathDeclared(RimeConfig* config, const std::string& path) {
+  const auto split = path.find_last_of('/');
+  const auto parent = split == std::string::npos ? "" : path.substr(0, split);
+  const auto name = split == std::string::npos ? path : path.substr(split + 1);
+  RegionConfigIterator iterator;
+  if (!iterator.Map(config, parent))
+    return false;
+  while (rime_api->config_next(&iterator.value)) {
+    if (iterator.value.key && name == iterator.value.key)
+      return true;
+  }
+  return false;
+}
+
+bool RegionScalar(RimeConfig* config, const char* path, std::string* text) {
+  // config_get_string may truncate without writing a terminator. Never parse
+  // a truncated prefix as a valid number, selector, color or font name.
+  char buffer[4097];
+  std::memset(buffer, 0xff, sizeof(buffer));
+  if (!rime_api->config_get_string(config, path, buffer, sizeof(buffer)))
+    return false;
+  const auto end = static_cast<const char*>(std::memchr(buffer, 0, sizeof(buffer)));
+  if (!end)
+    return false;
+  text->assign(buffer, static_cast<size_t>(end - buffer));
+  return true;
+}
+
+bool RegionInteger(const std::string& text, int minimum, int maximum, int* value) {
+  if (text.empty())
+    return false;
+  size_t at = 0;
+  bool negative = false;
+  if (text[at] == '-' || text[at] == '+') {
+    negative = text[at] == '-';
+    if (++at == text.size())
+      return false;
+  }
+  int64_t number = 0;
+  for (; at < text.size(); ++at) {
+    if (text[at] < '0' || text[at] > '9')
+      return false;
+    number = number * 10 + (text[at] - '0');
+    if (number > (std::numeric_limits<int>::max)())
+      return false;
+  }
+  if (negative)
+    number = -number;
+  if (number < minimum || number > maximum)
+    return false;
+  *value = static_cast<int>(number);
+  return true;
+}
+
+bool RegionWide(const std::string& text, std::wstring* wide) {
+  wide->clear();
+  if (text.empty())
+    return true;
+  const int count = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+      text.data(), static_cast<int>(text.size()), nullptr, 0);
+  if (count <= 0 || count > 1024)
+    return false;
+  wide->resize(count);
+  return MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text.data(),
+      static_cast<int>(text.size()), &(*wide)[0], count) == count;
+}
+
+bool RegionProvider(const std::string& text) {
+  if (text.size() > 64)
+    return false;
+  for (const unsigned char c : text) {
+    if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+          (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '-'))
+      return false;
+  }
+  return true;
+}
+
+int RegionColorBits(uint32_t raw) {
+  return raw <= static_cast<uint32_t>((std::numeric_limits<int>::max)())
+             ? static_cast<int>(raw) : -1 - static_cast<int>(~raw);
+}
+
+bool RegionColor(const std::string& text, ColorFormat format, int* value) {
+  std::string digits;
+  bool hexadecimal = text.size() > 2 && text[0] == '0' &&
+                     (text[1] == 'x' || text[1] == 'X');
+  if (hexadecimal)
+    digits = text.substr(2);
+#ifdef USE_SHARP_COLOR_CODE
+  else if (!text.empty() && text[0] == '#') {
+    hexadecimal = true;
+    digits = text.substr(1);
+  }
+#endif
+  uint32_t raw = 0;
+  bool opaque = !hexadecimal;
+  if (hexadecimal) {
+    if (digits.size() != 3 && digits.size() != 4 && digits.size() != 6 &&
+        digits.size() != 7 && digits.size() != 8)
+      return false;
+    opaque = digits.size() == 3 || digits.size() == 6;
+    if (digits.size() == 3 || digits.size() == 4) {
+      std::string expanded;
+      for (char digit : digits) {
+        expanded.push_back(digit);
+        expanded.push_back(digit);
+      }
+      digits.swap(expanded);
+    }
+    for (char digit : digits) {
+      int part = digit >= '0' && digit <= '9' ? digit - '0' :
+                 digit >= 'a' && digit <= 'f' ? digit - 'a' + 10 :
+                 digit >= 'A' && digit <= 'F' ? digit - 'A' + 10 : -1;
+      if (part < 0)
+        return false;
+      raw = (raw << 4) | static_cast<uint32_t>(part);
+    }
+  } else {
+    if (text.empty())
+      return false;
+    size_t at = 0;
+    const bool negative = text[0] == '-';
+    if (negative || text[0] == '+')
+      ++at;
+    if (at == text.size())
+      return false;
+    uint64_t number = 0;
+    for (; at < text.size(); ++at) {
+      if (text[at] < '0' || text[at] > '9')
+        return false;
+      number = number * 10 + text[at] - '0';
+      if (number > (negative ? 0x80000000ull : 0xffffffffull))
+        return false;
+    }
+    raw = negative ? 0u - static_cast<uint32_t>(number) :
+                     static_cast<uint32_t>(number);
+  }
+  if (opaque)
+    raw = format == COLOR_RGBA ? (raw << 8) | 0xffu : raw | 0xff000000u;
+  if (format == COLOR_ARGB)
+    raw = ARGB2ABGR(raw);
+  else if (format == COLOR_RGBA)
+    raw = RGBA2ABGR(raw);
+  *value = RegionColorBits(raw);
+  return true;
+}
+
+bool ParseRegionRule(RimeConfig* config, const std::string& path,
+                     ColorFormat format, RegionStyleRule* rule,
+                     std::string* error) {
+  RegionConfigIterator iterator;
+  if (!iterator.Map(config, path)) {
+    *error = "expected a rule map";
+    return false;
+  }
+  rule->region = L"*";
+  bool row_declared = false;
+  size_t fields = 0;
+  std::set<std::wstring> assigned;
+  const std::set<std::string> regions = {
+      "*", "candidate", "rod", "preedit", "auxiliary",
+      "main_background", "rod_background"};
+  const std::map<std::string, int> kinds = {
+      {"source", kRimeInteractionKindSource},
+      {"associated", kRimeInteractionKindAssociated},
+      {"output", kRimeInteractionKindOutput},
+      {"notice", kRimeInteractionKindNotice}};
+  const std::set<std::string> colors = {
+      "text_color", "candidate_text_color", "candidate_back_color",
+      "candidate_shadow_color", "candidate_border_color", "label_text_color",
+      "comment_text_color", "back_color", "interaction_rod_back_color",
+      "shadow_color", "border_color", "hilited_text_color", "hilited_back_color",
+      "hilited_shadow_color", "hilited_candidate_text_color",
+      "hilited_candidate_back_color", "hilited_candidate_shadow_color",
+      "hilited_candidate_border_color", "hilited_label_text_color",
+      "hilited_comment_text_color", "hilited_mark_color", "prevpage_color",
+      "nextpage_color"};
+  const std::set<std::string> geometry = {
+      "spacing", "candidate_spacing", "hilite_spacing", "hilite_padding_x",
+      "hilite_padding_y", "round_corner", "round_corner_ex", "border",
+      "shadow_radius"};
+  while (rime_api->config_next(&iterator.value)) {
+    if (++fields > 64 || !iterator.value.key || !iterator.value.path) {
+      *error = "more than 64 fields";
+      return false;
+    }
+    std::string key(iterator.value.key), text;
+    if (!RegionScalar(config, iterator.value.path, &text)) {
+      *error = key + ": expected a bounded scalar value";
+      return false;
+    }
+    if (key == "region") {
+      if (!regions.count(text)) {
+        *error = "unknown region";
+        return false;
+      }
+      rule->region.assign(text.begin(), text.end());
+      continue;
+    }
+    if (key == "kind") {
+      auto found = kinds.find(text);
+      if (found == kinds.end()) {
+        *error = "unknown kind";
+        return false;
+      }
+      rule->kind = found->second;
+      continue;
+    }
+    if (key == "style_key") {
+      if (!RegionProvider(text)) {
+        *error = "style_key must contain at most 64 ASCII letters/digits/_.-";
+        return false;
+      }
+      rule->style_key.assign(text.begin(), text.end());
+      continue;
+    }
+    if (key == "column" || key == "row") {
+      int value = 0;
+      if (!RegionInteger(text, 0, 65535, &value)) {
+        *error = key + ": expected an integer in 0..65535";
+        return false;
+      }
+      if (key == "row") {
+        row_declared = true;
+        rule->row = value;
+      } else {
+        rule->column = value;
+      }
+      continue;
+    }
+    if (key == "label_color")
+      key = "label_text_color";
+    else if (key == "hilited_label_color")
+      key = "hilited_label_text_color";
+    else if (key == "rod_back_color")
+      key = "interaction_rod_back_color";
+    std::wstring wide_key(key.begin(), key.end());
+    if (!assigned.insert(wide_key).second) {
+      *error = key + ": duplicate field alias";
+      return false;
+    }
+    if (key == "font_face" || key == "label_font_face" ||
+        key == "comment_font_face") {
+      std::wstring face;
+      if (!RegionWide(text, &face)) {
+        *error = key + ": invalid UTF-8 or more than 1024 UTF-16 units";
+        return false;
+      }
+      rule->strings[wide_key] = std::regex_replace(
+          face, std::wregex(L"\\s*(,|:|^|$)\\s*"), L"$1");
+      continue;
+    }
+    int number = 0, minimum = 0, maximum = 256;
+    if (colors.count(key)) {
+      if (!RegionColor(text, format, &number)) {
+        *error = key + ": invalid color";
+        return false;
+      }
+    } else if (key == "align_type") {
+      if (text == "top") number = UIStyle::ALIGN_TOP;
+      else if (text == "center") number = UIStyle::ALIGN_CENTER;
+      else if (text == "bottom") number = UIStyle::ALIGN_BOTTOM;
+      else {
+        *error = "align_type must be top/center/bottom";
+        return false;
+      }
+    } else {
+      if (key == "font_point" || key == "label_font_point" ||
+          key == "comment_font_point")
+        maximum = 200;
+      else if (key == "baseline" || key == "linespacing")
+        maximum = 300;
+      else if (key == "shadow_offset_x" || key == "shadow_offset_y")
+        minimum = -256;
+      else if (!geometry.count(key)) {
+        *error = key + ": unsupported field";
+        return false;
+      }
+      if (!RegionInteger(text, minimum, maximum, &number)) {
+        *error = key + ": invalid integer or out of range";
+        return false;
+      }
+    }
+    rule->integers[wide_key] = number;
+  }
+  if (row_declared && rule->region != L"rod" && rule->region != L"*") {
+    *error = "row is available only for rod or wildcard regions";
+    return false;
+  }
+  return true;
+}
