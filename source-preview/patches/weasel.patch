+                                    size_t header_size,
+                                    std::vector<char>* body) {
+  if (!body || !header || header_size == 0 || header_size > MAXDWORD ||
+      buff_size == 0 || buff_size > MAXDWORD)
+    throw static_cast<DWORD>(ERROR_INVALID_PARAMETER);
+  body->clear();
+  DWORD received = 0;
+  BOOL success = ::ReadFile(pipe, header, static_cast<DWORD>(header_size),
+                            &received, NULL);
+  DWORD error = success ? ERROR_SUCCESS : ::GetLastError();
+  if (!success && error != ERROR_MORE_DATA)
+    throw error;
+  if (received != header_size)
+    throw static_cast<DWORD>(ERROR_INVALID_DATA);
+  if (success)
+    return;
+
+  std::vector<char> request_body(buff_size);
+  success = ::ReadFile(pipe, request_body.data(),
+                       static_cast<DWORD>(request_body.size()), &received, NULL);
+  if (!success)
+    throw ::GetLastError();  // Includes ERROR_MORE_DATA for an oversized body.
+  request_body.resize(received);
+  *body = std::move(request_body);
+}
