diff --git a/include/WeaselInteraction.h b/include/WeaselInteraction.h
new file mode 100644
index 0000000000000000000000000000000000000000..bc20160eb53896a3487d4ada21db5fcc9b1a77b8
--- /dev/null
+++ b/include/WeaselInteraction.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace weasel {
+
+// Display metadata only. Real committed text remains in the server-side core.
+struct InteractionItem {
+  uint32_t id = 0;
+  uint32_t source_id = 0;
+  uint32_t attached_to_id = 0;
+  uint32_t rod_id = 0;
+  int32_t kind = 0;
+  int32_t menu_index = -1;
+  int32_t rod_index = -1;
+  std::wstring label;
+  std::wstring comment;
+  std::wstring hint;
+  std::wstring style_key;
+  bool reference_only = false;
+
+  bool operator==(const InteractionItem& other) const {
+    return id == other.id && source_id == other.source_id &&
+           attached_to_id == other.attached_to_id && rod_id == other.rod_id &&
+           kind == other.kind && menu_index == other.menu_index &&
+           rod_index == other.rod_index && label == other.label &&
+           comment == other.comment && hint == other.hint &&
+           style_key == other.style_key &&
+           reference_only == other.reference_only;
+  }
+  bool operator!=(const InteractionItem& other) const { return !(*this == other); }
+};
+
+struct InteractionTextSpan {
+  int32_t start = 0, end = 0;
+  std::wstring style_key;
+  bool highlightable = true;
+  bool operator==(const InteractionTextSpan& other) const {
+    return start == other.start && end == other.end &&
+           style_key == other.style_key && highlightable == other.highlightable;
+  }
+};
+
+struct InteractionFrame {
+  uint32_t protocol_version = 0;
+  uint64_t frame_token = 0;
+  uint32_t generation = 0;
+  uint32_t active_item_id = 0;
+  std::vector<InteractionItem> items;
+  std::wstring preedit_text;
+  std::vector<InteractionTextSpan> preedit_spans;
+
+  void clear() {
+    protocol_version = 0;
+    frame_token = 0;
+    generation = 0;
+    active_item_id = 0;
+    items.clear();
+    preedit_text.clear();
+    preedit_spans.clear();
+  }
+  bool empty() const { return protocol_version == 0; }
+  bool operator==(const InteractionFrame& other) const {
+    return protocol_version == other.protocol_version &&
+           frame_token == other.frame_token && generation == other.generation &&
+           active_item_id == other.active_item_id && items == other.items &&
+           preedit_text == other.preedit_text && preedit_spans == other.preedit_spans;
+  }
+  bool operator!=(const InteractionFrame& other) const { return !(*this == other); }
+};
+
+constexpr uint32_t kInteractionProtocolVersion = 3;
+constexpr size_t kInteractionMaxItems = 256;
+constexpr size_t kInteractionMaxFieldUnits = 4096;
+// UTF-16 line units, including the WI3: prefix; the caller must additionally
+// budget the complete IPC response (ordinary candidate data + this section).
+constexpr size_t kInteractionMaxWireChars = 24 * 1024;
+
+// WI3: followed by hexadecimal, explicitly little-endian integer fields and
+// length-prefixed UTF-16 strings. No native layout, pointer, payload or session
+// id is serialized. The value contains only ASCII and fits on one protocol line.
+// Invalid/oversized input clears the entire destination and returns false.
+bool EncodeInteractionFrame(const InteractionFrame& frame, std::wstring* wire);
+bool DecodeInteractionFrame(const std::wstring& wire, InteractionFrame* frame);
+
+enum class InteractionActionType : uint32_t { Highlight = 1, Select = 2 };
+struct InteractionAction {
+  uint64_t frame_token = 0;
+  uint32_t item_id = 0;
+  InteractionActionType action = InteractionActionType::Highlight;
+};
+constexpr size_t kInteractionActionBytes = 24;
+bool EncodeInteractionAction(const InteractionAction& action,
+                             std::vector<char>* bytes);
+bool DecodeInteractionAction(const std::vector<char>& bytes,
+                             InteractionAction* action);
+
+// Final hit-test rectangles, copied from the panel immediately before sending
+// a key. Reporting never commits, highlights, refreshes UI or claims any keys.
+struct InteractionLayoutRect {
+  uint32_t item_id = 0;
+  int32_t left = 0, top = 0, right = 0, bottom = 0;
+  bool operator==(const InteractionLayoutRect& other) const {
+    return item_id == other.item_id && left == other.left && top == other.top &&
+           right == other.right && bottom == other.bottom;
+  }
+};
+struct InteractionLayoutReport {
+  uint64_t frame_token = 0;
+  uint64_t layout_revision = 0;
+  std::vector<InteractionLayoutRect> rectangles;
+};
+bool EncodeInteractionLayout(const InteractionLayoutReport& report,
+                              std::vector<char>* bytes);
+bool DecodeInteractionLayout(const std::vector<char>& bytes,
+                              InteractionLayoutReport* report);
+
+}  // namespace weasel
