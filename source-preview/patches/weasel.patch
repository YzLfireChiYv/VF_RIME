index 0000000000000000000000000000000000000000..1645cbd65b0a5739b7b0414ab4c65f23cc756408
--- /dev/null
+++ b/include/WeaselRegionStyle.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <map>
+#include <string>
+#include <boost/serialization/map.hpp>
+#include <boost/serialization/string.hpp>
+
+namespace weasel {
+
+struct RegionStyleRule {
+  std::wstring region;
+  int kind = 0;
+  std::wstring style_key;
+  int column = 0;
+  int row = 0;
+  std::map<std::wstring, int> integers;
+  std::map<std::wstring, std::wstring> strings;
+
+  bool operator==(const RegionStyleRule& other) const {
+    return region == other.region && kind == other.kind &&
+           style_key == other.style_key && column == other.column &&
+           row == other.row && integers == other.integers &&
+           strings == other.strings;
+  }
+  bool operator!=(const RegionStyleRule& other) const { return !(*this == other); }
+};
+
+}  // namespace weasel
+
+namespace boost {
+namespace serialization {
+template <typename Archive>
+void serialize(Archive& ar, weasel::RegionStyleRule& rule,
+               const unsigned int version) {
+  ar & rule.region;
+  ar & rule.kind;
+  ar & rule.style_key;
+  ar & rule.column;
+  ar & rule.row;
+  ar & rule.integers;
+  ar & rule.strings;
+}
+}  // namespace serialization
+}  // namespace boost
