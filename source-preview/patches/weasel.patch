+void Layout::PrepareTextRegionStyles(PDWR pDWR) {
+  _regionStylePlain.font_point = _regionStyleSource.font_point;
+  _regionStylePlain.label_font_point = _regionStyleSource.label_font_point;
+  _regionStylePlain.comment_font_point = _regionStyleSource.comment_font_point;
+  _preeditRegion.resolved = ResolveStyle(pDWR, L"preedit");
+  _auxiliaryRegion.resolved = ResolveStyle(pDWR, L"auxiliary");
+  _mainBackgroundStyle = ResolveStyle(pDWR, L"main_background");
+  _preeditSpanStyles.clear();
+  const auto& frame = _context.interaction;
+  if (frame.protocol_version == kInteractionProtocolVersion && frame.frame_token &&
+      frame.preedit_text == _context.preedit.str) {
+    for (const auto& span : frame.preedit_spans) {
+      if (!span.style_key.empty() && !_preeditSpanStyles.count(span.style_key))
+        _preeditSpanStyles.emplace(span.style_key,
+            ResolveStyle(pDWR, L"preedit", 0, span.style_key));
+    }
+  }
+  auto reserve = [&](const UIStyle& s) {
+    real_margin_x = max(real_margin_x, s.hilite_padding_x);
+    real_margin_y = max(real_margin_y, s.hilite_padding_y);
+    int x = 0, y = 0;
+    if (s.shadow_radius) {
+      x = abs(s.shadow_offset_x) + s.shadow_radius * 2;
+      y = abs(s.shadow_offset_y) + s.shadow_radius * 2;
+      if (s.shadow_offset_x || s.shadow_offset_y) {
+        x -= s.shadow_radius / 2;
+        y -= s.shadow_radius / 2;
+      }
+    }
+    offsetX = max(offsetX, x + s.border * 2);
+    offsetY = max(offsetY, y + s.border * 2);
+  };
+  reserve(_preeditRegion.resolved->style);
+  reserve(_auxiliaryRegion.resolved->style);
+  reserve(_mainBackgroundStyle->style);
+  for (const auto& entry : _preeditSpanStyles)
+    reserve(entry.second->style);
+}
+
+std::shared_ptr<InteractionResolvedStyle> Layout::ResolveStyle(
+    PDWR pDWR, const std::wstring& region, int kind,
+    const std::wstring& style_key, int column, int row) const {
+  auto resolved = std::make_shared<InteractionResolvedStyle>();
+  resolved->style = ResolveRegionStyle(_regionStyleSource, region, kind,
+                                        style_key, column, row, &_regionStylePlain);
+  resolved->text_format = pDWR->GetRegionTextFormat(resolved->style, 0);
+  resolved->label_format = pDWR->GetRegionTextFormat(resolved->style, 1);
+  resolved->comment_format = pDWR->GetRegionTextFormat(resolved->style, 2);
+  resolved->preedit_format = pDWR->GetRegionTextFormat(resolved->style, 3);
+  auto& s = resolved->style;
+  const float scale = pDWR->dpiScaleLayout;
+  s.spacing = (int)(s.spacing * scale);
+  s.candidate_spacing = (int)(s.candidate_spacing * scale);
+  s.hilite_spacing = (int)(s.hilite_spacing * scale);
+  s.hilite_padding_x = (int)(s.hilite_padding_x * scale);
+  s.hilite_padding_y = (int)(s.hilite_padding_y * scale);
+  s.round_corner = (int)(s.round_corner * scale);
+  s.round_corner_ex = (int)(s.round_corner_ex * scale);
+  s.border = (int)(s.border * scale);
+  s.shadow_radius = (int)(s.shadow_radius * scale);
+  s.shadow_offset_x = (int)(s.shadow_offset_x * scale);
+  s.shadow_offset_y = (int)(s.shadow_offset_y * scale);
+  return resolved;
+}
