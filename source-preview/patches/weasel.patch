+void RimeWithWeaselHandler::_SyncInteractionCapabilities(WeaselSessionId ipc_id) {
+  auto found = m_session_status_map.find(ipc_id);
+  if (found == m_session_status_map.end())
+    return;
+  const auto& session = found->second;
+  const auto layout_type = session.style.layout_type;
+  const bool horizontal =
+      layout_type == UIStyle::LAYOUT_HORIZONTAL ||
+      layout_type == UIStyle::LAYOUT_HORIZONTAL_FULLSCREEN;
+  const bool live = session.focused && m_active_session == ipc_id;
+  const bool rich = live &&
+                    session.interaction_version == kInteractionProtocolVersion &&
+                    session.interaction && session.interaction->available() &&
+                    horizontal;
+  const char* layout = "unknown";
+  const char* text_orientation = "unknown";
+  switch (layout_type) {
+    case UIStyle::LAYOUT_HORIZONTAL:
+      layout = "horizontal";
+      text_orientation = "horizontal";
+      break;
+    case UIStyle::LAYOUT_HORIZONTAL_FULLSCREEN:
+      layout = "horizontal+fullscreen";
+      text_orientation = "horizontal";
+      break;
+    case UIStyle::LAYOUT_VERTICAL_FULLSCREEN:
+      layout = "vertical+fullscreen";
+      text_orientation = "horizontal";
+      break;
+    case UIStyle::LAYOUT_VERTICAL_TEXT:
+      layout = "vertical_text";
+      text_orientation = "vertical";
+      break;
+    case UIStyle::LAYOUT_VERTICAL:
+      layout = "vertical";
+      text_orientation = "horizontal";
+      break;
+    default:
+      break;
+  }
+  auto set_if_changed = [&](const char* key, const std::string& value) {
+    char current[128] = {};
+    rime_api->get_property(session.session_id, key, current, sizeof(current));
+    if (value != current)
+      rime_api->set_property(session.session_id, key, value.c_str());
+  };
+  set_if_changed("_interaction_frontend", rich ? "weasel-horizontal-v2" : "");
+  set_if_changed("_interaction_epoch", std::to_string(session.focus_epoch));
+  set_if_changed("_interaction_layout", layout);
+  set_if_changed("_interaction_text_orientation", text_orientation);
+  set_if_changed("_interaction_rods", rich ? "1" : "");
+  set_if_changed("_interaction_key_release", live ? "1" : "");
+  set_if_changed("_interaction_focus_cancel", live ? "1" : "");
+  const bool regions = live &&
+      session.interaction_version == kInteractionProtocolVersion;
+  const bool spatial = rich && session.interaction &&
+      session.interaction->spatial_available();
+  set_if_changed("_interaction_regions", regions ? "1" : "");
+  set_if_changed("_interaction_preedit_regions",
+      regions && session.interaction && session.interaction->preedit_regions_available()
+          ? "1" : "");
+  set_if_changed("_interaction_spatial", spatial ? "1" : "");
+  set_if_changed("_interaction_capability_version", "2");
+}
